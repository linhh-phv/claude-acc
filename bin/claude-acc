#!/usr/bin/env bash
# claude-acc — quản lý nhiều account Claude Code trên một máy (macOS)
#
# Mô hình:
#   - 1 acc "main"  : đăng nhập bằng `claude auth login`, credential nằm trong
#                     macOS Keychain. Đây là acc DUY NHẤT có claude.ai
#                     connectors, Remote Control và /schedule.
#   - N acc phụ     : mỗi acc một long-lived OAuth token (`claude setup-token`,
#                     hạn 1 năm), cất trong Keychain dưới service riêng và nạp
#                     qua biến môi trường CLAUDE_CODE_OAUTH_TOKEN khi chạy,
#                     hoặc qua khối `env` của ~/.claude/settings.json khi cần
#                     áp dụng cho cả GUI (Cursor/VS Code).
#
# Vì acc phụ không bao giờ ghi vào credential của Claude Code, việc đổi qua lại
# không làm mất đăng nhập của acc nào — hết bắt login/OTP lại.

set -euo pipefail

VERSION="1.0.0"
SVC="claude-code-token"
CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/claude-acc"
LIST="$CFG_DIR/accounts"
REPOS="$CFG_DIR/repos"
# Cho phep tro sang file khac de kiem thu ma khong dung vao acc that dang
# dung. Bo trong -> dung file that.
SETTINGS="${CLAUDE_ACC_SETTINGS:-$HOME/.claude/settings.json}"

c_dim=$'\033[2m'; c_b=$'\033[1m'; c_r=$'\033[31m'; c_g=$'\033[32m'; c_y=$'\033[33m'; c_0=$'\033[0m'
if [[ ! -t 1 ]]; then c_dim=; c_b=; c_r=; c_g=; c_y=; c_0=; fi

die()  { printf '%sloi:%s %s\n' "$c_r" "$c_0" "$*" >&2; exit 1; }
info() { printf '%b\n' "$*" >&2; }

[[ "$(uname -s)" == "Darwin" ]] || die "script nay chi chay tren macOS (dung \`security\` cua Keychain)."
command -v claude >/dev/null 2>&1 || die "khong tim thay \`claude\` trong PATH."

mkdir -p "$CFG_DIR"
touch "$LIST"
touch "$REPOS"

# ---------- helpers -------------------------------------------------------

valid_name() {
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] || die "ten acc chi duoc chua chu, so, . _ - (nhan duoc: '$1')"
  [[ "$1" != "main" ]] || die "'main' la ten danh rieng cho acc dang nhap bang Keychain."
}

known() { grep -qx -- "$1" "$LIST" 2>/dev/null; }

token_of() {
  security find-generic-password -s "$SVC" -a "$1" -w 2>/dev/null \
    || die "chua co token cho '$1'. Chay: claude-acc add $1"
}

remember() { known "$1" || printf '%s\n' "$1" >> "$LIST"; }

forget() {
  local tmp; tmp="$(mktemp)"
  grep -vx -- "$1" "$LIST" > "$tmp" 2>/dev/null || true
  mv "$tmp" "$LIST"
}

trim() { printf '%s' "$1" | tr -d '\r\n' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'; }

pinned_acc() {
  [[ -f "$SETTINGS" ]] || return 0
  python3 -c '
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: sys.exit(0)
print((d.get("env") or {}).get("CLAUDE_ACC_NAME") or "")
' "$SETTINGS" 2>/dev/null || true
}

# ---------- ghim theo thu muc (per-repo / per-workspace) -------------------
#
# Da do 2026-09-05, khong phai suy doan:
#   - `.claude/settings.local.json` DE LEN `.claude/settings.json` va de len
#     ca ~/.claude/settings.json; khoi `env` MERGE theo tung khoa, nen ghim
#     acc khong lam mat permissions/MCP dang co trong file.
#   - Settings cap repo CHI an khi `claude` chay DUNG o thu muc chua .claude/
#     — chay tu thu muc con KHONG ke thua (do bang token rac: root 401,
#     apps/web chay ngon).
#   - Trong Cursor/VS Code multi-root workspace, MOI tab chat deu chay voi
#     cwd = folder [0] cua file .code-workspace (do bang cwd tien trinh that:
#     3 phien cua workspace a-workspace deu o folder [0], du tab dang
#     lam viec tren worktree khac).
# => Cho nen ghim phai nham vao thu muc GUI thuc su chay, khong phai thu muc
#    ban dang dung o terminal.

# In ra: <loai>\t<thu-muc-dich>\t<ghi-chu>
#   WS    -> nam trong mot .code-workspace; dich la folder [0]
#   AMBIG -> nhieu workspace khac nhau cung chua thu muc nay
#   NONE  -> khong thuoc workspace nao
gui_root() {
  python3 - "$1" <<'PYEOF'
import json, os, re, sys, glob

start = os.path.realpath(sys.argv[1])
cands, seen = [], set()
d = start
for _ in range(6):
    parent = os.path.dirname(d)
    if parent == d:
        break
    for ws in sorted(glob.glob(os.path.join(parent, "*.code-workspace"))):
        if ws in seen:
            continue
        seen.add(ws)
        try:
            raw = open(ws, encoding="utf-8").read()
            try:
                data = json.loads(raw)
            except Exception:
                data = json.loads(re.sub(r"^\s*//.*$", "", raw, flags=re.M))
        except Exception:
            continue
        base = os.path.dirname(ws)
        paths = [os.path.realpath(os.path.join(base, f["path"]))
                 for f in (data.get("folders") or []) if f.get("path")]
        if not paths:
            continue
        if any(start == p or start.startswith(p + os.sep) for p in paths):
            cands.append((ws, paths[0], len(paths)))
    d = parent

if not cands:
    print("NONE\t\t")
else:
    roots = {c[1] for c in cands}
    if len(roots) > 1:
        names = ", ".join(os.path.basename(c[0]) for c in cands)
        print("AMBIG\t\t" + names)
    else:
        ws, root, n = cands[0]
        print("WS\t%s\t%s (%d folder)" % (root, os.path.basename(ws), n))
PYEOF
}

# Thu muc dich de ghim, tinh tu thu muc hien tai.
# stdout: <dir>\t<ghi-chu>   (ghi-chu rong neu la repo thuong)
resolve_target() {
  local base="${1:-$PWD}" line kind dir note
  line="$(gui_root "$base")"
  kind="${line%%$'\t'*}"; line="${line#*$'\t'}"
  dir="${line%%$'\t'*}"; note="${line#*$'\t'}"

  if [[ "$kind" == "AMBIG" ]]; then
    die "thu muc nay nam trong NHIEU workspace khac nhau ($note).
     Moi workspace chay claude o folder [0] cua no, nen khong doan duoc.
     Chi dinh thang: claude-acc here <ten> --at <duong-dan-folder-0>"
  fi
  if [[ "$kind" == "WS" && -n "$dir" ]]; then
    printf '%s\t%s\n' "$dir" "$note"
    return
  fi
  # khong thuoc workspace: dung git root neu co, khong thi chinh thu muc nay
  local top
  if top="$(git -C "$base" rev-parse --show-toplevel 2>/dev/null)" && [[ -n "$top" ]]; then
    printf '%s\t\n' "$top"
  else
    printf '%s\t\n' "$(cd "$base" && pwd -P)"
  fi
}

repo_file() { printf '%s/.claude/settings.local.json' "$1"; }

# Ten acc dang ghim tai <dir> (rong neu khong ghim). "main" = dung Keychain.
repo_pin() {
  local f; f="$(repo_file "$1")"
  [[ -f "$f" ]] || return 0
  python3 - "$f" <<'PYEOF' 2>/dev/null || true
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
env = d.get("env") or {}
name = env.get("CLAUDE_ACC_NAME")
if name:
    print(name)
elif env.get("CLAUDE_CODE_OAUTH_TOKEN") == "":
    print("main")
PYEOF
}

# Chan nguy co commit nham token. Khong sua .gitignore cua repo (nhat la repo
# cong ty) — dung .git/info/exclude: chi co tren may nay, khong vao lich su.
guard_git() {
  local dir="$1" rel=".claude/settings.local.json"
  git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 || return 0

  if git -C "$dir" ls-files --error-unmatch "$rel" >/dev/null 2>&1; then
    die "$rel cua repo nay DANG DUOC GIT THEO DOI — ghi token vao do la mot
     buoc di thang toi viec commit nham token len remote.
     Go theo doi truoc roi chay lai:
       git -C $dir rm --cached $rel"
  fi

  git -C "$dir" check-ignore -q "$rel" 2>/dev/null && return 0

  local common
  common="$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
  if [[ -z "$common" ]]; then
    common="$(git -C "$dir" rev-parse --git-common-dir 2>/dev/null || true)"
    [[ "$common" == /* ]] || common="$dir/$common"
  fi
  [[ -d "$common" ]] || return 0
  mkdir -p "$common/info"
  if ! grep -qxF "$rel" "$common/info/exclude" 2>/dev/null; then
    printf '%s\n' "$rel" >> "$common/info/exclude"
    info "${c_dim}  (da them $rel vao .git/info/exclude — chi may nay, khong vao repo)${c_0}"
  fi
}

# So dang ky cac thu muc da ghim: <path>\t<acc>. Chi de `ls`/`reassign`/`sync`
# biet duong ma tim — nguon su that van la file trong tung thu muc.
reg_set() {
  python3 - "$REPOS" "$1" "$2" <<'PYEOF'
import os, sys
reg, path, acc = sys.argv[1], sys.argv[2], sys.argv[3]
rows = []
if os.path.exists(reg):
    for ln in open(reg, encoding="utf-8"):
        ln = ln.rstrip("\n")
        if not ln.strip():
            continue
        p = ln.split("\t")[0]
        if p != path:
            rows.append(ln)
rows.append("%s\t%s" % (path, acc))
rows.sort()
fd = os.open(reg + ".t", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w", encoding="utf-8") as f:
    f.write("\n".join(rows) + "\n")
os.replace(reg + ".t", reg)
PYEOF
}

reg_del() {
  python3 - "$REPOS" "$1" <<'PYEOF'
import os, sys
reg, path = sys.argv[1], sys.argv[2]
if not os.path.exists(reg):
    sys.exit(0)
rows = [ln.rstrip("\n") for ln in open(reg, encoding="utf-8")
        if ln.strip() and ln.split("\t")[0] != path]
fd = os.open(reg + ".t", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w", encoding="utf-8") as f:
    f.write(("\n".join(rows) + "\n") if rows else "")
os.replace(reg + ".t", reg)
PYEOF
}

# Ghi ghim vao <dir>. name=main -> token RONG (da do: de len token cap tren
# roi roi ve Keychain). Merge vao file co san, atomic, 600.
write_repo_pin() {
  local dir="$1" name="$2" tok="$3"
  mkdir -p "$dir/.claude"
  CLAUDE_ACC_TOK="$tok" python3 - "$(repo_file "$dir")" "$name" <<'PYEOF' \
    || die "khong sua duoc $(repo_file "$dir") (file loi cu phap JSON?)"
import json, os, sys
p, name = sys.argv[1], sys.argv[2]
tok = os.environ.get("CLAUDE_ACC_TOK", "")
d = {}
if os.path.exists(p):
    with open(p, encoding="utf-8") as f:
        d = json.load(f)          # loi cu phap -> nem, khong ghi de
env = d.get("env") or {}
if name == "off":
    env.pop("CLAUDE_CODE_OAUTH_TOKEN", None)
    env.pop("CLAUDE_ACC_NAME", None)
else:
    env["CLAUDE_CODE_OAUTH_TOKEN"] = tok   # "" khi name == main
    env["CLAUDE_ACC_NAME"] = name
if env:
    d["env"] = env
elif "env" in d:
    del d["env"]
if not d:
    if os.path.exists(p):
        os.remove(p)
    sys.exit(0)
fd = os.open(p + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w", encoding="utf-8") as f:
    json.dump(d, f, indent=2, ensure_ascii=False)
    f.write("\n")
os.replace(p + ".tmp", p)
PYEOF
}

# Thu mot request that. `claude auth status` chi bao NGUON credential chu khong
# xac nhan credential do con song, nen day la cach duy nhat biet chac.
# stdout: thong bao ngan. exit 0 = dung duoc.
probe() {
  local out
  if out="$(claude -p 'reply with exactly: OK' --model haiku 2>&1)"; then
    case "$out" in
      *OK*) printf 'token hop le, goi duoc API\n'; return 0 ;;
    esac
  fi
  printf '%s\n' "$(printf '%s' "$out" | head -3)"
  return 1
}

# Lay chuoi 'sk-ant-…' tu clipboard, ke ca khi copy dinh chu xung quanh.
token_from_clip() {
  command -v pbpaste >/dev/null 2>&1 || return 0
  pbpaste 2>/dev/null | grep -m1 -o 'sk-ant-oat01-[A-Za-z0-9._-]*' || true
}

# Tao script tam de lam bien BROWSER. Claude Code goi no voi URL la $1
# (da kiem chung: setup-token co ton trong BROWSER tren macOS).

# Chay `claude setup-token` qua `script` — cong cu chuyen ghi lai phien lam
# viec cua mot chuong trinh tuong tac MA KHONG lam no mat nhan thuc ve
# terminal that. Khac voi `$(...)` (da thu truoc do, gay treo vi bien stdout
# thanh MOT PIPE): `script` cap cho claude MOT PTY THAT, nen no van thay minh
# dang chay tren terminal binh thuong, con minh thi doc lai duoc noi dung tu
# file log de tu trich token — khong can nguoi dung tu copy/paste nua.
#
# Neu khong co `script`, hoac khong trich duoc token (vd nguoi dung Ctrl+C
# giua chung), tra ve rong qua bien CAPTURED_TOKEN — cmd_add() se roi xuong
# hoi token thu cong nhu binh thuong, khong bao gio bi ket chi vi buoc tu
# dong nay khong thanh cong.
CAPTURED_TOKEN=""
run_setup_token_capture() {
  local wrapper="$1" logf status
  CAPTURED_TOKEN=""

  if ! command -v script >/dev/null 2>&1; then
    if [[ -n "$wrapper" ]]; then BROWSER="$wrapper" claude setup-token; else claude setup-token; fi
    return $?
  fi

  logf="$(mktemp -t claude-acc-typescript)" || die "khong tao duoc file tam."
  if [[ -n "$wrapper" ]]; then
    BROWSER="$wrapper" script -q "$logf" claude setup-token
  else
    script -q "$logf" claude setup-token
  fi
  status=$?
  CAPTURED_TOKEN="$(grep -m1 -o 'sk-ant-oat01-[A-Za-z0-9._-]*' "$logf" 2>/dev/null || true)"
  rm -f "$logf"
  return $status
}

mk_browser_wrapper() {
  local app="$1" f
  f="$(mktemp -t claude-acc-browser)" || die "khong tao duoc file tam."
  # QUAN TRONG: wrapper KHONG duoc in bat cu thu gi ra terminal (stdout/stderr).
  # `claude setup-token` dung "alternate screen buffer" (giao dien toan man
  # hinh) trong luc cho duyet; wrapper ghi chu tu vao terminal NGAY LUC DO
  # (da kiem chung bang thuc nghiem: co in la treo, khong nhan phim nua, kieu
  # dang bi treo qua `--browser` nhung khong bi qua chay `claude setup-token`
  # tran) co the lam hong trang thai ve/con tro cua no. `claude` da TU IN URL
  # rieng nhu mot phuong an du phong, nen wrapper chi can lam dung 1 viec:
  # mo app hoac copy vao clipboard, tuyet doi im lang.
  if [[ "$app" == "__clip__" ]]; then
    cat > "$f" <<'W'
#!/bin/sh
printf '%s' "$1" | pbcopy 2>/dev/null
W
  else
    local q_app; q_app="$(printf '%q' "$app")"
    cat > "$f" <<EOF
#!/bin/sh
open -a $q_app "\$1"
EOF
  fi
  chmod +x "$f"
  printf '%s' "$f"
}

# Doc token tu terminal. Co y KHONG dung `read -s`: token dai, an het ky tu
# thi khong biet dan duoc hay chua. Bo trong + Enter thi lay tu clipboard.
read_token() {
  local name="$1" raw=""
  printf '%sToken cho '\''%s'\''%s — dan vao roi Enter (ky tu se bi an), hoac chi Enter de lay tu clipboard:\n> ' \
    "$c_b" "$name" "$c_0" >&2
  # Dung `read -s`: token khong bao gio duoc echo ra man hinh/scrollback
  # (tranh lo qua ghi hinh terminal, tmux log, chia se man hinh). De bu lai
  # viec khong thay minh go gi, in ngay ban xem truoc da che (prefix/suffix/
  # do dai) sau khi doc xong — cho ca truong hop go tay lan lay tu clipboard.
  IFS= read -rs raw </dev/tty || true
  printf '\n' >&2
  raw="$(trim "$raw")"

  if [[ -z "$raw" ]] && command -v pbpaste >/dev/null 2>&1; then
    # CHI nhan chuoi sk-ant-… tu clipboard. Truoc day co fallback `head -1`
    # vo dai dong dau tien, nen clipboard con sot code cu la lay nham -> bao
    # loi "khong phai token" du nguoi dung lam dung. Da bo.
    raw="$(trim "$(token_from_clip)")"
  fi
  if [[ -n "$raw" ]]; then
    printf '%sda nhan: %s…%s (%d ky tu)%s\n' \
      "$c_dim" "${raw:0:14}" "${raw: -4}" "${#raw}" "$c_0" >&2
  fi
  printf '%s' "$raw"
}

# `cp` tren macOS/Linux GIU NGUYEN quyen cua file DICH cu neu no da ton tai,
# chi copy quyen nguon khi tao file dich MOI. Neu settings.json goc tung co
# quyen long (vd 644), file backup se ket lai quyen do MAI MAI qua moi lan
# switch, ro ri token cua nhung lan truoc cho user khac tren may. Vi vay luon
# chmod 600 backup ngay sau khi cp, khong dua vao quyen cua file dich cu.
backup_settings() {
  [[ -f "$SETTINGS" ]] || return 0
  # `install -m` dat quyen 600 NGAY LUC ghi, khong co khoang ho giua luc file
  # co du lieu va luc bi sieet quyen (khac voi cp roi chmod sau — neu file
  # goc dang quyen long, co mot khoang thoi gian token nam trong file doc
  # duoc boi user khac tren may).
  install -m 600 "$SETTINGS" "$SETTINGS.bak-claude-acc"
}

# ---------- commands ------------------------------------------------------

cmd_add() {
  local name="" browser="" mode="ask" run_setup=1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --browser)  browser="${2:-}"
                  [[ -n "$browser" ]] || die "--browser can ten app, vd: --browser \"Brave Browser\""
                  [[ "$browser" != -* ]] || die "--browser can ten app, khong phai '$browser' (thieu ten app truoc do?)"
                  shift 2 ;;
      --url-only) browser="__clip__"; shift ;;
      --clip)     mode="clip"; shift ;;
      --stdin)    mode="stdin"; shift ;;
      --no-setup) run_setup=0; shift ;;
      -*)         die "tuy chon khong biet: $1 (xem: claude-acc help)" ;;
      *)          [[ -z "$name" ]] || die "thua tham so: $1"; name="$1"; shift ;;
    esac
  done
  [[ -n "$name" ]] || die "dung: claude-acc add <ten-acc> [--browser <app>|--url-only] [--clip|--stdin|--no-setup]"
  valid_name "$name"

  if security find-generic-password -s "$SVC" -a "$name" -w >/dev/null 2>&1; then
    info "${c_y}'$name' da co token — se ghi de.${c_0}"
  fi

  if [[ -n "$browser" && "$browser" != "__clip__" && ! -d "/Applications/$browser.app" ]]; then
    info "${c_y}khong thay /Applications/$browser.app${c_0} — van thu, nhung kiem tra lai ten app."
  fi

  local wrapper="" tok=""
  if (( run_setup )); then
    case "$browser" in
      "")        info "\n${c_y}Se mo BROWSER MAC DINH.${c_0} Neu acc '$name' nam o browser khac, dung\n  --browser \"Brave Browser\" | \"Google Chrome\" | \"Safari\"\nhoac --url-only de tu dan URL." ;;
      __clip__)  wrapper="$(mk_browser_wrapper __clip__)"; info "\n${c_b}Che do --url-only:${c_0} URL duyet se tu dong duoc COPY VAO CLIPBOARD (khong tu mo browser). Dan (Cmd+V) vao dung cua so/profile can dang nhap." ;;
      *)         wrapper="$(mk_browser_wrapper "$browser")"; info "\n${c_b}Se duyet trong: $browser${c_0} — neu no mo nham profile, \`claude setup-token\` cung se tu in URL o ben duoi de ban tu dan sang cua so dung." ;;
    esac

    cat >&2 <<EOF

${c_dim}Sau khi ban bam Authorize (hoac dan code neu duoc hoi), token se duoc
tu dong bat lai — khong can copy/paste. Neu vi ly do nao do khong bat duoc,
ban se duoc hoi dan token thu cong ngay sau day.${c_0}

EOF

    info "${c_dim}--- claude setup-token ---${c_0}"
    # Co y KHONG dung `</dev/tty`: da kiem chung thuc te — luong "Paste code
    # here" cua `claude setup-token` khong nhan phim/paste khi stdin bi mo
    # lai qua /dev/tty. claude-acc luon duoc goi truc tiep trong mot terminal
    # that, nen stdin da san la terminal do — mo lai la thua va gay loi nay.
    run_setup_token_capture "$wrapper" || true
    tok="$CAPTURED_TOKEN"
    [[ -n "$wrapper" ]] && rm -f "$wrapper"
    info "${c_dim}--------------------------${c_0}"

    if [[ -n "$tok" ]]; then
      info "${c_g}✓ da tu bat duoc token${c_0} (${tok:0:14}…${tok: -4}, ${#tok} ky tu) — khong can copy/paste."
    else
      info "${c_y}khong bat duoc token tu output cua setup-token.${c_0} Dan tay ben duoi."
    fi
  fi

  # `claude setup-token` la TUI; no co the tra terminal ve trang thai raw
  # khien `read` ben duoi khong nhan duoc gi. Dua stty ve binh thuong truoc.
  { stty sane </dev/tty; } >/dev/null 2>&1 || true

  if [[ -z "$tok" ]]; then
    case "$mode" in
      clip)  tok="$(token_from_clip)"
             [[ -n "$tok" ]] || die "clipboard khong chua chuoi 'sk-ant-…'. Copy token roi chay lai."
             info "${c_dim}lay tu clipboard: ${tok:0:14}…${tok: -4} (${#tok} ky tu)${c_0}" ;;
      stdin) IFS= read -r tok || true; tok="$(trim "$tok")" ;;
      *)     tok="$(read_token "$name")" ;;
    esac
  fi
  [[ -n "$tok" ]] || die "token rong, huy."

  if [[ "$tok" != sk-ant-oat01-* ]]; then
    cat >&2 <<EOF
${c_r}Day khong phai token.${c_0} Token that bat dau bang 'sk-ant-oat01-'.
Nhieu kha nang ban dan nham ${c_b}code${c_0} — chuoi ngan browser hien ra. Do la
dau vao cua \`claude setup-token\`, khong phai ket qua.

Token la chuoi dai ma \`claude setup-token\` ${c_b}IN RA${c_0} sau khi duyet xong.
EOF
    exit 1
  fi

  security add-generic-password -U \
    -s "$SVC" -a "$name" -w "$tok" \
    -D "Claude Code account token" \
    -j "Token dang nhap Claude Code cho acc '$name' (quan ly boi claude-acc)" \
    || die "khong ghi duoc vao Keychain."

  remember "$name"
  info "${c_dim}da luu '$name'. Dang kiem tra bang mot request that…${c_0}"

  # `probe` la ham co san trong chinh script nay, subshell da thua ke duoc —
  # khong can `bash -c "$(declare -f probe); probe"`. Va export trong subshell
  # thay vi `env VAR=val cmd`: dung `env` de gan bien tao ra mot tien trinh
  # rieng ma chinh argv cua no chua token — `ps -ef` cua user khac tren may
  # doc duoc trong luc lenh chay. export/subshell khong tao tien trinh nao co
  # token trong argv ca.
  if ( export CLAUDE_CODE_OAUTH_TOKEN="$tok"; probe ) >&2; then
    info "${c_g}✓ '$name' san sang.${c_0} Dung: claude-acc switch $name"
  else
    info "${c_r}✗ token luu roi nhung KHONG goi duoc API.${c_0}"
    info "  Chay lai \`claude-acc add $name --browser \"<browser cua acc do>\"\`."
    return 1
  fi
}

# Doi acc cho CA Cursor/VS Code GUI lan terminal, bang khoi `env` trong
# ~/.claude/settings.json (docs: file nay duoc CHIA SE giua extension va CLI).
# Da do: khoi `env` DE LEN ca credential Keychain lan bien moi truong cua
# tien trinh — nen day la cong tac duy nhat, khong the dung song song voi
# `claude-acc run`.
#
# Da do lai 2026-09-05 (extension 2.1.260 va ca ban cu 2.1.198): CLI doc lai
# settings.json o TUNG request, khong phai mot lan luc khoi dong. Bang chung:
# doi token thanh rac giua mot phien stream-json -> luot ke tiep bao 401 ngay.
# Vi vay switch AN NGAY, khong can Reload Window — va cung vi vay no ap len
# ca nhung phien dang chay do o cua so/repo khac.
cmd_switch() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "dung: claude-acc switch <ten-acc|main>"

  local tok=""
  if [[ "$name" != "main" ]]; then
    valid_name "$name"
    tok="$(token_of "$name")"
  fi

  backup_settings

  # Token truyen qua bien moi truong CLAUDE_ACC_TOK (khong phai argv) de
  # khong lo qua `ps` cua user khac tren may — argv cua moi tien trinh la
  # cong khai (ps -ef), con environ thi khong. File dich duoc tao qua
  # os.open voi mode 0o600 TUONG MINH roi os.replace (atomic rename) —
  # khong bao gio co lat file ton tai o quyen long, du la file moi hay de
  # len file cu.
  CLAUDE_ACC_TOK="$tok" python3 -c '
import json,sys,os
p,name=sys.argv[1],sys.argv[2]
tok=os.environ.get("CLAUDE_ACC_TOK","")
d={}
if os.path.exists(p):
    with open(p) as f: d=json.load(f)          # loi cu phap -> nem, khong ghi de
env=d.get("env") or {}
if name=="main":
    env.pop("CLAUDE_CODE_OAUTH_TOKEN",None); env.pop("CLAUDE_ACC_NAME",None)
else:
    env["CLAUDE_CODE_OAUTH_TOKEN"]=tok; env["CLAUDE_ACC_NAME"]=name
if env: d["env"]=env
elif "env" in d: del d["env"]
tmp=p+".tmp"
fd=os.open(tmp, os.O_WRONLY|os.O_CREAT|os.O_TRUNC, 0o600)
with os.fdopen(fd,"w") as f:
    json.dump(d,f,indent=2,ensure_ascii=False); f.write("\n")
os.replace(tmp,p)
' "$SETTINGS" "$name" \
    || die "khong sua duoc $SETTINGS (file loi cu phap JSON?). Ban goc: $SETTINGS.bak-claude-acc"

  if [[ "$name" == "main" ]]; then
    info "${c_g}Da chuyen ve 'main'${c_0} (credential Keychain — day du connectors)."
  else
    info "${c_g}Da chuyen sang '$name'${c_0} (token)."
    info "${c_y}Luu y: token nam DANG VAN BAN trong $SETTINGS (quyen 600).${c_0}"
  fi
  info "${c_b}An ngay — KHONG can Reload Window.${c_0}"
  info "${c_dim}CLI doc lai settings.json o TUNG request, nen ca nhung phien${c_0}"
  info "${c_dim}dang chay (moi cua so, moi repo) cung doi sang acc nay ngay.${c_0}"

  # ... TRU nhung thu muc da ghim rieng: ghim cap repo de len ghim toan cuc.
  # Neu dung ngay trong mot cho nhu vay ma khong noi gi, nguoi dung se tuong
  # da doi acc cho repo nay.
  local _l _gdir _gpin
  _l="$(resolve_target "$PWD" 2>/dev/null || true)"; _gdir="${_l%%$'\t'*}"
  _gpin="$(repo_pin "$(pwd -P)")"
  [[ -z "$_gpin" && -n "$_gdir" && "$_gdir" != "$(pwd -P)" ]] && _gpin="$(repo_pin "$_gdir")"
  if [[ -n "$_gpin" && "$_gpin" != "$name" ]]; then
    info ""
    info "${c_y}Nhung KHONG doi cho cho ban dang dung:${c_0} noi nay ghim rieng acc '$_gpin'"
    info "${c_dim}  (ghim cap repo de len ghim toan cuc).${c_0}"
    info "${c_dim}  Doi luon cho nay:  claude-acc switch $name --here${c_0}"
    info "${c_dim}  Bo ghim rieng   :  claude-acc switch off --here${c_0}"
  fi

  info "${c_dim}Kiem tra bang mot request that…${c_0}"
  cmd_check "$name"
}

# Dang nhap acc "main" (ghi vao Keychain), chon duoc browser.
# Ghim acc cho MOT THU MUC (repo hoac workspace), doc lap voi ghim toan cuc.
cmd_here() {
  local name="" at="" check=1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --at)  at="${2:-}"; [[ -n "$at" ]] || die "--at can mot duong dan"; shift 2 ;;
      --at=*) at="${1#*=}"; shift ;;
      --no-check) check=0; shift ;;
      -*)    die "tuy chon khong biet: '$1'" ;;
      *)     [[ -z "$name" ]] || die "chi nhan MOT ten acc (nhan duoc them: '$1')"
             name="$1"; shift ;;
    esac
  done
  [[ -n "$name" ]] || die "dung: claude-acc switch <ten-acc|main|off> --here [--at <thu-muc>]
       main = repo nay dung acc chinh (Keychain) · off = bo ghim rieng"

  local dir note=""
  if [[ -n "$at" ]]; then
    [[ -d "$at" ]] || die "khong thay thu muc: $at"
    dir="$(cd "$at" && pwd -P)"
  else
    local line; line="$(resolve_target "$PWD")"
    dir="${line%%$'\t'*}"; note="${line#*$'\t'}"
  fi

  local tok=""
  case "$name" in
    off)  ;;
    main) ;;
    *)    valid_name "$name"; tok="$(token_of "$name")" ;;
  esac

  if [[ "$name" == "off" ]]; then
    local cur; cur="$(repo_pin "$dir")"
    [[ -n "$cur" ]] || die "thu muc nay chua ghim acc nao: $dir"
    write_repo_pin "$dir" off ""
    reg_del "$dir"
    info "${c_g}Da bo ghim${c_0} cho: $dir"
    info "${c_dim}Tu gio thu muc nay theo acc toan cuc (claude-acc switch).${c_0}"
    return
  fi

  guard_git "$dir"
  write_repo_pin "$dir" "$name" "$tok"
  reg_set "$dir" "$name"

  if [[ "$name" == "main" ]]; then
    info "${c_g}Da ghim 'main'${c_0} (Keychain) cho: $dir"
  else
    info "${c_g}Da ghim '$name'${c_0} cho: $dir"
    info "${c_y}Token nam DANG VAN BAN trong $(repo_file "$dir") (quyen 600).${c_0}"
  fi
  [[ -n "$note" ]] && info "${c_dim}  $note — moi tab chat cua workspace nay deu chay o do,${c_0}" \
                   && info "${c_dim}  nen ghim ap cho ca workspace, khong rieng mot worktree.${c_0}"

  local here_now; here_now="$(cd "$PWD" && pwd -P)"
  if [[ "$here_now" != "$dir" ]]; then
    info "${c_dim}  (ban dang dung o $here_now — ghi vao thu muc tren vi settings cap${c_0}"
    info "${c_dim}   repo chi an o dung thu muc claude chay, khong ke thua xuong con.)${c_0}"
  fi

  info "${c_b}An ngay${c_0} — khong can Reload Window, khong can mo tab chat moi."
  [[ "$check" == 1 ]] || return 0
  info "${c_dim}Kiem tra bang mot request that o dung thu muc do…${c_0}"
  local out
  if out="$(cd "$dir" && env -u CLAUDE_CODE_OAUTH_TOKEN claude -p 'reply with exactly: OK' --model haiku 2>&1)" \
     && [[ "$out" == *OK* ]]; then
    info "${c_g}✓ acc '$name' goi duoc API tai thu muc do.${c_0}"
  else
    info "${c_r}✗ ghim roi nhung KHONG goi duoc API tai do:${c_0}"
    info "  $(printf '%s' "$out" | head -2)"
    return 1
  fi
}

# Doi hang loat: moi thu muc dang dung <cu> chuyen sang <moi>. Dung khi mot
# acc gan cham limit va muon san tai sang acc khac.
cmd_reassign() {
  local old="${1:-}" new="${2:-}"
  [[ -n "$old" && -n "$new" ]] || die "dung: claude-acc reassign <acc-cu> <acc-moi|main>"
  local tok=""
  if [[ "$new" != "main" ]]; then valid_name "$new"; tok="$(token_of "$new")"; fi

  local n=0 missing=0 dir acc
  while IFS=$'\t' read -r dir acc; do
    [[ -n "$dir" ]] || continue
    [[ "$acc" == "$old" ]] || continue
    if [[ ! -d "$dir" ]]; then
      info "${c_y}  bo qua (thu muc khong con): $dir${c_0}"; missing=$((missing+1)); continue
    fi
    guard_git "$dir"
    write_repo_pin "$dir" "$new" "$tok"
    reg_set "$dir" "$new"
    info "  $dir"
    n=$((n+1))
  done < "$REPOS"

  [[ $n -gt 0 ]] || die "khong co thu muc nao dang ghim '$old'."
  info "${c_g}Da chuyen $n thu muc tu '$old' sang '$new'.${c_0}"
  [[ $missing -gt 0 ]] && info "${c_dim}($missing thu muc trong so dang ky da khong con — chay \`claude-acc sync\` de don.)${c_0}"
  info "${c_dim}An ngay cho ca cac phien dang mo o nhung thu muc do.${c_0}"
}

# Ghi lai token hien tai vao moi thu muc da ghim. Dung sau khi `add` lai mot
# acc (token moi) hoac khi nghi ngo file trong repo bi sua/mat.
cmd_sync() {
  local n=0 fixed=0 gone=0 dir acc
  while IFS=$'\t' read -r dir acc; do
    [[ -n "$dir" ]] || continue
    if [[ ! -d "$dir" ]]; then
      info "${c_y}  don khoi so dang ky (thu muc khong con): $dir${c_0}"
      reg_del "$dir"; gone=$((gone+1)); continue
    fi
    local tok=""
    if [[ "$acc" != "main" ]]; then
      if ! tok="$(security find-generic-password -s "$SVC" -a "$acc" -w 2>/dev/null)"; then
        info "${c_r}  bo qua $dir — mat token cua '$acc' (chay: claude-acc add $acc)${c_0}"
        continue
      fi
    fi
    local before; before="$(repo_pin "$dir")"
    guard_git "$dir"
    write_repo_pin "$dir" "$acc" "$tok"
    [[ "$before" == "$acc" ]] || { info "  sua lai: $dir ($before -> $acc)"; fixed=$((fixed+1)); }
    n=$((n+1))
  done < "$REPOS"
  info "${c_g}Da dong bo $n thu muc.${c_0}"
  [[ $fixed -gt 0 ]] && info "${c_dim}($fixed cho lech so voi so dang ky, da ghi lai.)${c_0}"
  [[ $gone -gt 0 ]] && info "${c_dim}($gone thu muc khong con, da don khoi so dang ky.)${c_0}"
}

cmd_login() {
  local browser=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --browser)  browser="${2:-}"
                  [[ -n "$browser" ]] || die "--browser can ten app."
                  [[ "$browser" != -* ]] || die "--browser can ten app, khong phai '$browser' (thieu ten app truoc do?)"
                  shift 2 ;;
      --url-only) browser="__clip__"; shift ;;
      *)          die "dung: claude-acc login [--browser <app>|--url-only]" ;;
    esac
  done

  info "${c_y}Luu y:${c_0} lenh nay GHI DE credential trong Keychain — acc 'main' hien tai"
  info "se bi thay the. Cac acc phu (dung token) khong bi anh huong."

  local wrapper=""
  [[ -n "$browser" ]] && wrapper="$(mk_browser_wrapper "$browser")"
  [[ -n "$browser" && "$browser" != "__clip__" ]] && info "${c_b}Se duyet trong: $browser${c_0}"

  # Khong dung `</dev/tty`: xem giai thich trong cmd_add() — mo lai stdin qua
  # /dev/tty lam luong "Paste code here" cua claude khong nhan duoc phim/paste.
  if [[ -n "$wrapper" ]]; then
    BROWSER="$wrapper" claude auth login || true
    rm -f "$wrapper"
  else
    claude auth login || true
  fi

  { stty sane </dev/tty; } >/dev/null 2>&1 || true
  info "\n${c_dim}Ket qua:${c_0}"
  cmd_check main
}

cmd_rm() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "dung: claude-acc rm <ten-acc>"
  valid_name "$name"
  security delete-generic-password -s "$SVC" -a "$name" >/dev/null 2>&1 \
    || info "${c_y}khong tim thay token cua '$name' trong Keychain (van go khoi danh sach).${c_0}"
  forget "$name"
  if [[ "$(pinned_acc)" == "$name" ]]; then
    info "${c_y}'$name' dang duoc ghim — bo ghim luon.${c_0}"
    cmd_switch main >&2 || true
  fi
  info "${c_g}da xoa '$name'.${c_0}"
}

cmd_ls() {
  local who
  who="$(env -u CLAUDE_CODE_OAUTH_TOKEN bash -c 'claude auth status --json 2>/dev/null' | python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: print(""); sys.exit()
def walk(o):
    if isinstance(o,dict):
        for k,v in o.items():
            if k.lower() in ("email","emailaddress","account_email") and isinstance(v,str): return v
            r=walk(v)
            if r: return r
    elif isinstance(o,list):
        for v in o:
            r=walk(v)
            if r: return r
    return None
print(walk(d) or "")
' 2>/dev/null || true)"

  local pin; pin="$(pinned_acc)"
  printf '%sTOAN CUC%s  %s  %s(~/.claude/settings.json)%s\n' \
    "$c_b" "$c_0" "${pin:-main}" "$c_dim" "$c_0"

  # Chay claude o THU MUC NAY thi acc nao that su co hieu luc? Settings cap
  # repo chi an o dung thu muc chua .claude/, nen phai hoi theo tung thu muc.
  local hp; hp="$(repo_pin "$(pwd -P)")"
  if [[ -n "$hp" ]]; then
    printf '%sTAI DAY%s   %s  %s(ghim cua %s)%s\n' \
      "$c_b" "$c_0" "$hp" "$c_dim" "$(pwd -P)" "$c_0"
  else
    printf '%sTAI DAY%s   %s  %s(khong ghim rieng — theo toan cuc)%s\n' \
      "$c_b" "$c_0" "${pin:-main}" "$c_dim" "$c_0"
  fi

  # GUI cua Cursor/VS Code chay o folder [0] cua workspace, khong phai o thu
  # muc ban dang dung — neu hai cho lech nhau thi noi ro.
  local line gdir gnote gpin
  line="$(resolve_target "$PWD" 2>/dev/null || true)"
  gdir="${line%%$'\t'*}"; gnote="${line#*$'\t'}"
  if [[ -n "$gdir" && "$gdir" != "$(pwd -P)" ]]; then
    gpin="$(repo_pin "$gdir")"
    printf '%sGUI%s       %s  %s(%s%s)%s\n' \
      "$c_b" "$c_0" "${gpin:-${pin:-main}}" "$c_dim" "$gdir" \
      "${gnote:+ — $gnote}" "$c_0"
  fi
  printf '\n'

  printf '%smain%s  %s(Keychain — day du connectors, Remote Control)%s\n' \
    "$c_b" "$c_0" "$c_dim" "$c_0"
  [[ -n "$who" ]] && printf '        %s%s%s\n' "$c_dim" "$who" "$c_0"

  if [[ -s "$LIST" ]]; then
    printf '\n%sacc phu%s %s(token — khong co connectors)%s\n' "$c_b" "$c_0" "$c_dim" "$c_0"
    while IFS= read -r a; do
      [[ -n "$a" ]] || continue
      if security find-generic-password -s "$SVC" -a "$a" -w >/dev/null 2>&1; then
        printf '  %s✓%s %s\n' "$c_g" "$c_0" "$a"
      else
        printf '  %s✗%s %s %s(mat token — chay: claude-acc add %s)%s\n' "$c_r" "$c_0" "$a" "$c_dim" "$a" "$c_0"
      fi
    done < "$LIST"
  else
    printf '\n%schua co acc phu nao. Them bang: claude-acc add <ten>%s\n' "$c_dim" "$c_0"
  fi

  if [[ -s "$REPOS" ]]; then
    printf '\n%sGHIM THEO THU MUC%s %s(claude-acc here)%s\n' "$c_b" "$c_0" "$c_dim" "$c_0"
    local d a mark
    while IFS=$'\t' read -r d a; do
      [[ -n "$d" ]] || continue
      mark=" "
      [[ "$d" == "$(pwd -P)" ]] && mark="*"
      if [[ -d "$d" ]]; then
        printf '  %s %-8s %s\n' "$mark" "$a" "${d/#$HOME/~}"
      else
        printf '  %s %-8s %s %s(thu muc khong con — claude-acc sync)%s\n' \
          "$mark" "$a" "${d/#$HOME/~}" "$c_dim" "$c_0"
      fi
    done < "$REPOS"
  fi
}

cmd_run() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "dung: claude-acc run <ten-acc|main> [-- <tham so cho claude>]"
  shift
  [[ "${1:-}" == "--" ]] && shift

  # Khoi `env` trong settings.json de len bien moi truong (da do), nen khi da
  # ghim thi `run` khong doi duoc acc nua — bao thang thay vi chay sai am tham.
  # Ghim cap thu muc de len ca ghim toan cuc lan bien moi truong, nen phai
  # kiem no TRUOC — neu khong `run` se chay sai acc mot cach am tham.
  local hpin; hpin="$(repo_pin "$(pwd -P)")"
  if [[ -n "$hpin" && "$hpin" != "$name" ]]; then
    die "thu muc nay dang GHIM acc '$hpin' ($(repo_file "$(pwd -P)")) — no de len \`run\`.
     Doi ghim:  claude-acc here $name
     Bo ghim :  claude-acc here off"
  fi

  local pin; pin="$(pinned_acc)"
  if [[ -n "$pin" && -z "$hpin" && "$pin" != "$name" ]]; then
    if [[ "$name" == "main" ]]; then
      die "dang GHIM acc '$pin' trong ~/.claude/settings.json — no de len \`run\`.
     Bo ghim: claude-acc switch main"
    else
      die "dang GHIM acc '$pin' trong ~/.claude/settings.json — no de len \`run\`.
     Doi ghim: claude-acc switch $name"
    fi
  fi

  if [[ "$name" == "main" ]]; then
    exec env -u CLAUDE_CODE_OAUTH_TOKEN claude "$@"
  fi
  valid_name "$name"
  # QUAN TRONG: gan tok o mot dong RIENG truoc khi dung. Neu nhet thang
  # "$(token_of "$name")" vao lam gia tri cho bien cua `env`, exit code cua
  # token_of (goi die/exit 1 khi khong co token) bi NUOT MAT — `env ...` van
  # duoc coi la mot lenh don, thanh cong, va chay `claude` voi token RONG
  # thay vi dung lai. Tach dong nay de set -e bat duoc loi that.
  local tok; tok="$(token_of "$name")"
  export CLAUDE_CODE_OAUTH_TOKEN="$tok"
  exec claude "$@"
}

cmd_env() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "dung: eval \"\$(claude-acc env <ten-acc|main>)\""
  if [[ "$name" == "main" ]]; then
    printf 'unset CLAUDE_CODE_OAUTH_TOKEN\n'
    return
  fi
  valid_name "$name"
  # Tach dong: xem giai thich trong cmd_run() — nhet truc tiep vao %q se nuot
  # mat loi cua token_of, in ra mot dong `export ...=''` nhin nhu hop le.
  local tok; tok="$(token_of "$name")"
  printf 'export CLAUDE_CODE_OAUTH_TOKEN=%q\n' "$tok"
}

cmd_check() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "dung: claude-acc check <ten-acc|main>"

  if [[ "$name" == "main" ]]; then
    env -u CLAUDE_CODE_OAUTH_TOKEN claude auth status --text
    printf '%sdang thu mot request that…%s\n' "$c_dim" "$c_0" >&2
    if ( unset CLAUDE_CODE_OAUTH_TOKEN; probe ); then
      printf '%s✓ main dung duoc%s\n' "$c_g" "$c_0"
    else
      printf '%s✗ main KHONG dung duoc%s — chay: claude auth login\n' "$c_r" "$c_0"
      return 1
    fi
    return
  fi

  valid_name "$name"
  local tok; tok="$(token_of "$name")"
  ( export CLAUDE_CODE_OAUTH_TOKEN="$tok"; claude auth status --text )
  printf '%sdang thu mot request that…%s\n' "$c_dim" "$c_0" >&2
  if ( export CLAUDE_CODE_OAUTH_TOKEN="$tok"; probe ); then
    printf '%s✓ %s dung duoc%s\n' "$c_g" "$name" "$c_0"
  else
    printf '%s✗ %s KHONG dung duoc%s — chay lai: claude-acc add %s (chon Y)\n' \
      "$c_r" "$name" "$c_0" "$name"
    return 1
  fi
}

cmd_uninstall() {
  info "${c_b}Se go bo:${c_0}"
  [[ -s "$LIST" ]] && while IFS= read -r a; do [[ -n "$a" ]] && info "  - token Keychain cua '$a'"; done < "$LIST"
  info "  - $CFG_DIR (danh sach acc phu)"
  if [[ -s "$REPOS" ]]; then
    while IFS=$'\t' read -r _d _a; do
      [[ -n "$_d" ]] && info "  - bo ghim + xoa token trong $(repo_file "$_d")"
    done < "$REPOS"
  fi
  [[ -n "$(pinned_acc)" ]] && info "  - bo ghim trong $SETTINGS (dua ve 'main')"
  [[ -f "$SETTINGS.bak-claude-acc" ]] && info "  - $SETTINGS.bak-claude-acc (ban sao luu, con chua token cu)"
  local self; self="$(command -v claude-acc 2>/dev/null || printf '%s' "$0")"
  info "${c_dim}Sau buoc nay, xoa tay file binh: $self${c_0}"

  local yn
  read -r -p "Xac nhan xoa? [y/N] " yn </dev/tty || true
  [[ "${yn:-n}" == [yY]* ]] || { info "da huy."; return 1; }

  if [[ -s "$LIST" ]]; then
    while IFS= read -r a; do
      [[ -n "$a" ]] || continue
      security delete-generic-password -s "$SVC" -a "$a" >/dev/null 2>&1 || true
    done < "$LIST"
  fi
  # Token con nam DANG VAN BAN trong tung thu muc da ghim — phai don TRUOC
  # khi xoa $CFG_DIR, vi so dang ky (duong di toi cac file do) nam trong do.
  if [[ -s "$REPOS" ]]; then
    while IFS=$'\t' read -r _d _a; do
      [[ -n "$_d" && -d "$_d" ]] || continue
      write_repo_pin "$_d" off "" 2>/dev/null || info "${c_y}  khong don duoc: $(repo_file "$_d")${c_0}"
    done < "$REPOS"
  fi
  [[ -n "$(pinned_acc)" ]] && cmd_switch main >&2 || true
  # cmd_switch main o tren TU TAO mot ban backup moi (chua token cua acc vua
  # bo ghim) truoc khi xoa no o day — khong bo sot buoc nay, neu khong token
  # cuoi cung van song trong file .bak du nguoi dung tuong da xoa sach.
  rm -f "$SETTINGS.bak-claude-acc"
  rm -rf "$CFG_DIR"
  info "${c_g}xong.${c_0} Xoa tiep binh claude-acc khoi PATH neu muon go hoan toan."
}

cmd_help() {
  cat <<EOF
${c_b}claude-acc${c_0} v${VERSION} — nhieu account Claude Code tren mot may, khong login lai

${c_b}LENH${c_0}
  add <ten> [tuy chon]   Them acc phu: chay \`claude setup-token\`, luu token vao Keychain
      --browser <app>      Duyet trong app nay thay vi browser mac dinh
                           (vd: "Google Chrome" | "Safari" | "Brave Browser")
      --url-only           Khong mo browser; COPY URL duyet vao clipboard de tu dan
      --clip               Lay token tu clipboard, khong hoi gi
      --stdin              Doc token tu stdin:  pbpaste | claude-acc add x --stdin
      --no-setup           Bo qua buoc sinh token (khi da co token san)
  switch <ten|main>      Doi acc cho CA Cursor/VS Code GUI lan terminal, AN NGAY
                         — khong can Reload Window. DAY LA LENH CHINH DE DOI ACC.
                         Luu y: ap ngay cho CA CAC PHIEN DANG CHAY o moi repo.
  switch <ten|main|off> --here
                         Nhu tren, nhung CHI cho repo/workspace ban dang dung
                         — de moi repo mot acc, khoi don limit vao mot acc.
                         \`off\` = bo ghim rieng, quay ve theo acc toan cuc.
      --at <thu-muc>       ghim cho thu muc khac thay vi thu muc hien tai
      --no-check           bo qua buoc goi thu API sau khi ghim
  reassign <cu> <moi>    Chuyen MOI thu muc dang ghim <cu> sang <moi>
  sync                   Ghi lai token cho moi thu muc da ghim (sau khi \`add\`
                         lai mot acc, hoac khi nghi file trong repo bi sua)
  ls                     Liet ke acc (main + cac acc phu, kem tinh trang token)
  check <ten|main>       Goi mot request that de xac nhan acc do con dung duoc
  login [--browser <app>]  Dang nhap acc 'main' (ghi de Keychain), chon browser
  rm <ten>               Xoa acc phu khoi Keychain
  run <ten|main> [-- args]  (nang cao) Chay claude bang acc do CHI CHO LENH NAY,
                         khong doi acc dang ghim. Loi neu dang co acc khac ghim.
  env <ten|main>         (nang cao) In lenh export de doi acc cho SHELL HIEN TAI:
                           eval "\$(claude-acc env ten-acc)"
  uninstall              Xoa toan bo token trong Keychain va cau hinh cua claude-acc
  version, -v            In phien ban
  help, -h               In huong dan nay

${c_b}BAT DAU NHANH${c_0}
  claude-acc add ca-nhan --browser "Safari"   # duyet trong browser dang login acc do
  claude-acc switch ca-nhan                   # doi acc cho ca terminal lan GUI
  claude                                      # dung claude nhu binh thuong
  claude-acc switch main                      # doi ve acc chinh

  cd <repo> && claude-acc switch ca-nhan --here   # rieng repo nay dung acc khac
  claude-acc switch main --here                  # rieng repo nay dung main
  claude-acc switch off --here                   # bo ghim rieng cua repo
  claude-acc reassign ca-nhan acc-2           # acc-1 gan het limit -> san tai

${c_b}GHIM THEO THU MUC — hai dieu PHAI biet (deu da do, khong phai suy doan)${c_0}
  - Settings cap repo chi an khi \`claude\` chay DUNG o thu muc chua .claude/.
    Chay tu thu muc con KHONG ke thua — \`cd apps/web && claude\` se am tham
    dung acc toan cuc. \`claude-acc ls\` cho biet acc nao that su co hieu luc.
  - Trong Cursor/VS Code multi-root workspace, MOI tab chat deu chay o folder
    [0] cua file .code-workspace, ke ca khi tab do lam viec tren worktree
    khac. Nen ghim ap cho CA workspace, khong rieng mot worktree — va
    \`here\` tu nham vao folder [0] thay vi thu muc ban dang dung.

${c_b}LUU Y${c_0}
  - Chi acc 'main' co claude.ai connectors, Remote Control va /schedule.
    Chon acc dung nhieu nhat lam main.
  - \`claude setup-token\` KHONG ghi vao Keychain cua acc 'main' — them acc phu
    khong bao gio lam mat dang nhap cua acc chinh. Chi \`claude-acc login\` moi
    ghi de Keychain.
  - Token \`setup-token\` song 1 nam. Het han thi \`claude-acc add <ten>\` lai.
  - \`switch\` ghi token DANG VAN BAN vao ~/.claude/settings.json (quyen 600) vi
    Cursor/VS Code doc credential tu do, khong doc duoc Keychain rieng theo acc.
  - History/session dung chung giua cac acc (khong tach CLAUDE_CONFIG_DIR).
EOF
}

# ---------- dispatch ------------------------------------------------------

case "${1:-help}" in
  add)                shift; cmd_add "$@" ;;
  here|pin)           shift; cmd_here "$@" ;;
  reassign)           shift; cmd_reassign "$@" ;;
  sync)               shift; cmd_sync "$@" ;;
  switch|use)
    shift
    # `switch <ten> --here` la cach viet khac cua `here <ten>`
    if printf '%s\n' "$@" | grep -qx -- '--here'; then
      _args=()
      for _x in "$@"; do [[ "$_x" == "--here" ]] || _args+=("$_x"); done
      # ${a[@]} tren mang RONG lam `set -u` nem "unbound variable" — phai dung
      # dang ${a[@]+...} de cmd_here con kip in huong dan dung lenh.
      cmd_here ${_args[@]+"${_args[@]}"}
    else
      cmd_switch "$@"
    fi
    ;;
  login)              shift; cmd_login "$@" ;;
  rm|remove|del)      shift; cmd_rm "$@" ;;
  ls|list)            shift; cmd_ls "$@" ;;
  run|exec)           shift; cmd_run "$@" ;;
  env)                shift; cmd_env "$@" ;;
  check|status)       shift; cmd_check "$@" ;;
  uninstall)          shift; cmd_uninstall "$@" ;;
  version|-v|--version) printf 'claude-acc %s\n' "$VERSION" ;;
  help|-h|--help)     cmd_help ;;
  *)                  die "lenh khong biet: '$1'. Xem: claude-acc help" ;;
esac
