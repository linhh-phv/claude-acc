die()  { printf '%s%s%s %s\n' "$c_r" "$(t err_prefix)" "$c_0" "$*" >&2; exit 1; }
info() { printf '%b\n' "$*" >&2; }

[[ "$(uname -s)" == "Darwin" ]] || die "$(t err_macos)"
command -v claude >/dev/null 2>&1 || die "$(t err_no_claude)"

mkdir -p "$CFG_DIR"
touch "$LIST"
touch "$REPOS"

# ---------- helpers -------------------------------------------------------

valid_name() {
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] || die "$(tp err_bad_name "$1")"
  [[ "$1" != "main" ]] || die "$(t err_main_res)"
}

known() { grep -qx -- "$1" "$LIST" 2>/dev/null; }

token_of() {
  security find-generic-password -s "$SVC" -a "$1" -w 2>/dev/null \
    || die "$(tp err_no_token "$1" "$1")"
}

remember() { known "$1" || printf '%s\n' "$1" >> "$LIST"; }

forget() {
  local tmp; tmp="$(mktemp)"
  grep -vx -- "$1" "$LIST" > "$tmp" 2>/dev/null || true
  mv "$tmp" "$LIST"
}

trim() { printf '%s' "$1" | tr -d '\r\n' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'; }

pinned_acc() {
  [[ -f "$SETTINGS" ]] || return 0
  python3 -c '
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: sys.exit(0)
print((d.get("env") or {}).get("CLAUDE_ACC_NAME") or "")
' "$SETTINGS" 2>/dev/null || true
}

# ---------- ghim theo thu muc (per-repo / per-workspace) -------------------
#
# Da do 2026-09-05, khong phai suy doan:
#   - `.claude/settings.local.json` DE LEN `.claude/settings.json` va de len
#     ca ~/.claude/settings.json; khoi `env` MERGE theo tung khoa, nen ghim
#     acc khong lam mat permissions/MCP dang co trong file.
#   - Settings cap repo CHI an khi `claude` chay DUNG o thu muc chua .claude/
#     — chay tu thu muc con KHONG ke thua (do bang token rac: root 401,
#     apps/web chay ngon).
#   - Trong Cursor/VS Code multi-root workspace, MOI tab chat deu chay voi
#     cwd = folder [0] cua file .code-workspace (do bang cwd tien trinh that:
#     3 phien chat cua mot workspace 6 folder deu o folder [0], du mot tab
#     dang lam viec tren worktree khac).
# => Cho nen ghim phai nham vao thu muc GUI thuc su chay, khong phai thu muc
#    ban dang dung o terminal.

# In ra: <loai>\t<thu-muc-dich>\t<ghi-chu>
#   WS    -> nam trong mot .code-workspace; dich la folder [0]
#   AMBIG -> nhieu workspace khac nhau cung chua thu muc nay
#   NONE  -> khong thuoc workspace nao
gui_root() {
  python3 - "$1" <<'PYEOF'
import json, os, re, sys, glob

start = os.path.realpath(sys.argv[1])
cands, seen = [], set()
d = start
for _ in range(6):
    parent = os.path.dirname(d)
    if parent == d:
        break
    for ws in sorted(glob.glob(os.path.join(parent, "*.code-workspace"))):
        if ws in seen:
            continue
        seen.add(ws)
        try:
            raw = open(ws, encoding="utf-8").read()
            try:
                data = json.loads(raw)
            except Exception:
                data = json.loads(re.sub(r"^\s*//.*$", "", raw, flags=re.M))
        except Exception:
            continue
        base = os.path.dirname(ws)
        paths = [os.path.realpath(os.path.join(base, f["path"]))
                 for f in (data.get("folders") or []) if f.get("path")]
        if not paths:
            continue
        if any(start == p or start.startswith(p + os.sep) for p in paths):
            cands.append((ws, paths[0], len(paths)))
    d = parent

if not cands:
    print("NONE\t\t")
else:
    roots = {c[1] for c in cands}
    if len(roots) > 1:
        names = ", ".join(os.path.basename(c[0]) for c in cands)
        print("AMBIG\t\t" + names)
    else:
        ws, root, n = cands[0]
        print("WS\t%s\t%s (%d folder)" % (root, os.path.basename(ws), n))
PYEOF
}

# Thu muc dich de ghim, tinh tu thu muc hien tai.
# stdout: <dir>\t<ghi-chu>   (ghi-chu rong neu la repo thuong)
resolve_target() {
  local base="${1:-$PWD}" line kind dir note
  line="$(gui_root "$base")"
  kind="${line%%$'\t'*}"; line="${line#*$'\t'}"
  dir="${line%%$'\t'*}"; note="${line#*$'\t'}"

  if [[ "$kind" == "AMBIG" ]]; then
    die "$(tp err_ambig_ws "$note")"
  fi
  if [[ "$kind" == "WS" && -n "$dir" ]]; then
    printf '%s\t%s\n' "$dir" "$note"
    return
  fi
  # khong thuoc workspace: dung git root neu co, khong thi chinh thu muc nay
  local top
  if top="$(git -C "$base" rev-parse --show-toplevel 2>/dev/null)" && [[ -n "$top" ]]; then
    printf '%s\t\n' "$top"
  else
    printf '%s\t\n' "$(cd "$base" && pwd -P)"
  fi
}

repo_file() { printf '%s/.claude/settings.local.json' "$1"; }

# Ten acc dang ghim tai <dir> (rong neu khong ghim). "main" = dung Keychain.
repo_pin() {
  local f; f="$(repo_file "$1")"
  [[ -f "$f" ]] || return 0
  python3 - "$f" <<'PYEOF' 2>/dev/null || true
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
env = d.get("env") or {}
name = env.get("CLAUDE_ACC_NAME")
if name:
    print(name)
elif env.get("CLAUDE_CODE_OAUTH_TOKEN") == "":
    print("main")
PYEOF
}

# Chan nguy co commit nham token. Khong sua .gitignore cua repo (nhat la repo
# cong ty) — dung .git/info/exclude: chi co tren may nay, khong vao lich su.
guard_git() {
  local dir="$1" rel=".claude/settings.local.json"
  git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 || return 0

  if git -C "$dir" ls-files --error-unmatch "$rel" >/dev/null 2>&1; then
    die "$(tp err_git_track "$rel" "$dir" "$rel")"
  fi

  git -C "$dir" check-ignore -q "$rel" 2>/dev/null && return 0

  local common
  common="$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
  if [[ -z "$common" ]]; then
    common="$(git -C "$dir" rev-parse --git-common-dir 2>/dev/null || true)"
    [[ "$common" == /* ]] || common="$dir/$common"
  fi
  [[ -d "$common" ]] || return 0
  mkdir -p "$common/info"
  if ! grep -qxF "$rel" "$common/info/exclude" 2>/dev/null; then
    printf '%s\n' "$rel" >> "$common/info/exclude"
    info "${c_dim}$(tp git_excluded "$rel")${c_0}"
  fi
}

# So dang ky cac thu muc da ghim: <path>\t<acc>. Chi de `ls`/`reassign`/`sync`
# biet duong ma tim — nguon su that van la file trong tung thu muc.
reg_set() {
  python3 - "$REPOS" "$1" "$2" <<'PYEOF'
import os, sys
reg, path, acc = sys.argv[1], sys.argv[2], sys.argv[3]
rows = []
if os.path.exists(reg):
    for ln in open(reg, encoding="utf-8"):
        ln = ln.rstrip("\n")
        if not ln.strip():
            continue
        p = ln.split("\t")[0]
        if p != path:
            rows.append(ln)
rows.append("%s\t%s" % (path, acc))
rows.sort()
fd = os.open(reg + ".t", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w", encoding="utf-8") as f:
    f.write("\n".join(rows) + "\n")
os.replace(reg + ".t", reg)
PYEOF
}

reg_del() {
  python3 - "$REPOS" "$1" <<'PYEOF'
import os, sys
reg, path = sys.argv[1], sys.argv[2]
if not os.path.exists(reg):
    sys.exit(0)
rows = [ln.rstrip("\n") for ln in open(reg, encoding="utf-8")
        if ln.strip() and ln.split("\t")[0] != path]
fd = os.open(reg + ".t", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w", encoding="utf-8") as f:
    f.write(("\n".join(rows) + "\n") if rows else "")
os.replace(reg + ".t", reg)
PYEOF
}

# Ghi ghim vao <dir>. name=main -> token RONG (da do: de len token cap tren
# roi roi ve Keychain). Merge vao file co san, atomic, 600.
write_repo_pin() {
  local dir="$1" name="$2" tok="$3"
  mkdir -p "$dir/.claude"
  CLAUDE_ACC_TOK="$tok" python3 - "$(repo_file "$dir")" "$name" <<'PYEOF' \
    || die "$(tp err_write_repo "$(repo_file "$dir")")"
import json, os, sys
p, name = sys.argv[1], sys.argv[2]
tok = os.environ.get("CLAUDE_ACC_TOK", "")
d = {}
if os.path.exists(p):
    with open(p, encoding="utf-8") as f:
        d = json.load(f)          # loi cu phap -> nem, khong ghi de
env = d.get("env") or {}
if name == "off":
    env.pop("CLAUDE_CODE_OAUTH_TOKEN", None)
    env.pop("CLAUDE_ACC_NAME", None)
else:
    env["CLAUDE_CODE_OAUTH_TOKEN"] = tok   # "" khi name == main
    env["CLAUDE_ACC_NAME"] = name
if env:
    d["env"] = env
elif "env" in d:
    del d["env"]
if not d:
    if os.path.exists(p):
        os.remove(p)
    sys.exit(0)
fd = os.open(p + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w", encoding="utf-8") as f:
    json.dump(d, f, indent=2, ensure_ascii=False)
    f.write("\n")
os.replace(p + ".tmp", p)
PYEOF
}

# Thu mot request that. `claude auth status` chi bao NGUON credential chu khong
# xac nhan credential do con song, nen day la cach duy nhat biet chac.
# stdout: thong bao ngan. exit 0 = dung duoc.
probe() {
  local out
  if out="$(claude -p 'reply with exactly: OK' --model haiku 2>&1)"; then
    case "$out" in
      *OK*) printf '%s\n' "$(t probe_ok)"; return 0 ;;
    esac
  fi
  printf '%s\n' "$(printf '%s' "$out" | head -3)"
  return 1
}

# Lay chuoi 'sk-ant-…' tu clipboard, ke ca khi copy dinh chu xung quanh.
token_from_clip() {
  command -v pbpaste >/dev/null 2>&1 || return 0
  pbpaste 2>/dev/null | grep -m1 -o 'sk-ant-oat01-[A-Za-z0-9._-]*' || true
}

# Tao script tam de lam bien BROWSER. Claude Code goi no voi URL la $1
# (da kiem chung: setup-token co ton trong BROWSER tren macOS).

# Chay `claude setup-token` qua `script` — cong cu chuyen ghi lai phien lam
# viec cua mot chuong trinh tuong tac MA KHONG lam no mat nhan thuc ve
# terminal that. Khac voi `$(...)` (da thu truoc do, gay treo vi bien stdout
# thanh MOT PIPE): `script` cap cho claude MOT PTY THAT, nen no van thay minh
# dang chay tren terminal binh thuong, con minh thi doc lai duoc noi dung tu
# file log de tu trich token — khong can nguoi dung tu copy/paste nua.
#
# Neu khong co `script`, hoac khong trich duoc token (vd nguoi dung Ctrl+C
# giua chung), tra ve rong qua bien CAPTURED_TOKEN — cmd_add() se roi xuong
# hoi token thu cong nhu binh thuong, khong bao gio bi ket chi vi buoc tu
# dong nay khong thanh cong.
CAPTURED_TOKEN=""
run_setup_token_capture() {
  local wrapper="$1" logf status
  CAPTURED_TOKEN=""

  if ! command -v script >/dev/null 2>&1; then
    if [[ -n "$wrapper" ]]; then BROWSER="$wrapper" claude setup-token; else claude setup-token; fi
    return $?
  fi

  logf="$(mktemp -t claude-acc-typescript)" || die "$(t err_tmpfile)"
  if [[ -n "$wrapper" ]]; then
    BROWSER="$wrapper" script -q "$logf" claude setup-token
  else
    script -q "$logf" claude setup-token
  fi
  status=$?
  CAPTURED_TOKEN="$(grep -m1 -o 'sk-ant-oat01-[A-Za-z0-9._-]*' "$logf" 2>/dev/null || true)"
  rm -f "$logf"
  return $status
}

mk_browser_wrapper() {
  local app="$1" f
  f="$(mktemp -t claude-acc-browser)" || die "$(t err_tmpfile)"
  # QUAN TRONG: wrapper KHONG duoc in bat cu thu gi ra terminal (stdout/stderr).
  # `claude setup-token` dung "alternate screen buffer" (giao dien toan man
  # hinh) trong luc cho duyet; wrapper ghi chu tu vao terminal NGAY LUC DO
  # (da kiem chung bang thuc nghiem: co in la treo, khong nhan phim nua, kieu
  # dang bi treo qua `--browser` nhung khong bi qua chay `claude setup-token`
  # tran) co the lam hong trang thai ve/con tro cua no. `claude` da TU IN URL
  # rieng nhu mot phuong an du phong, nen wrapper chi can lam dung 1 viec:
  # mo app hoac copy vao clipboard, tuyet doi im lang.
  if [[ "$app" == "__clip__" ]]; then
    cat > "$f" <<'W'
#!/bin/sh
printf '%s' "$1" | pbcopy 2>/dev/null
W
  else
    local q_app; q_app="$(printf '%q' "$app")"
    cat > "$f" <<EOF
#!/bin/sh
open -a $q_app "\$1"
EOF
  fi
  chmod +x "$f"
  printf '%s' "$f"
}

# Doc token tu terminal. Co y KHONG dung `read -s`: token dai, an het ky tu
# thi khong biet dan duoc hay chua. Bo trong + Enter thi lay tu clipboard.
read_token() {
  local name="$1" raw=""
  printf '%s%s%s%s\n> ' \
    "$c_b" "$(tp tok_prompt "$1")" "$c_0" "$(t tok_prompt2)" >&2
  # Dung `read -s`: token khong bao gio duoc echo ra man hinh/scrollback
  # (tranh lo qua ghi hinh terminal, tmux log, chia se man hinh). De bu lai
  # viec khong thay minh go gi, in ngay ban xem truoc da che (prefix/suffix/
  # do dai) sau khi doc xong — cho ca truong hop go tay lan lay tu clipboard.
  IFS= read -rs raw </dev/tty || true
  printf '\n' >&2
  raw="$(trim "$raw")"

  if [[ -z "$raw" ]] && command -v pbpaste >/dev/null 2>&1; then
    # CHI nhan chuoi sk-ant-… tu clipboard. Truoc day co fallback `head -1`
    # vo dai dong dau tien, nen clipboard con sot code cu la lay nham -> bao
    # loi "khong phai token" du nguoi dung lam dung. Da bo.
    raw="$(trim "$(token_from_clip)")"
  fi
  if [[ -n "$raw" ]]; then
    printf '%s%s%s\n' "$c_dim" "$(tp tok_got "${raw:0:14}" "${raw: -4}" "${#raw}")" "$c_0" >&2
  fi
  printf '%s' "$raw"
}

# `cp` tren macOS/Linux GIU NGUYEN quyen cua file DICH cu neu no da ton tai,
# chi copy quyen nguon khi tao file dich MOI. Neu settings.json goc tung co
# quyen long (vd 644), file backup se ket lai quyen do MAI MAI qua moi lan
# switch, ro ri token cua nhung lan truoc cho user khac tren may. Vi vay luon
# chmod 600 backup ngay sau khi cp, khong dua vao quyen cua file dich cu.
backup_settings() {
  [[ -f "$SETTINGS" ]] || return 0
  # `install -m` dat quyen 600 NGAY LUC ghi, khong co khoang ho giua luc file
  # co du lieu va luc bi sieet quyen (khac voi cp roi chmod sau — neu file
  # goc dang quyen long, co mot khoang thoi gian token nam trong file doc
  # duoc boi user khac tren may).
  install -m 600 "$SETTINGS" "$SETTINGS.bak-claude-acc"
}

# ---------- commands ------------------------------------------------------

cmd_add() {
  local name="" browser="" mode="ask" run_setup=1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --browser)  browser="${2:-}"
                  [[ -n "$browser" ]] || die "$(t err_br_app)"
                  [[ "$browser" != -* ]] || die "$(tp err_br_bad "$browser")"
                  shift 2 ;;
      --url-only) browser="__clip__"; shift ;;
      --clip)     mode="clip"; shift ;;
      --stdin)    mode="stdin"; shift ;;
      --no-setup) run_setup=0; shift ;;
      -*)         die "$(tp err_unknown "$1")" ;;
      *)          [[ -z "$name" ]] || die "$(tp err_extra "$1")"; name="$1"; shift ;;
    esac
  done
  [[ -n "$name" ]] || die "$(t usage_add)"
  valid_name "$name"

  if security find-generic-password -s "$SVC" -a "$name" -w >/dev/null 2>&1; then
    info "${c_y}$(tp add_overwrite "$name")${c_0}"
  fi

  if [[ -n "$browser" && "$browser" != "__clip__" && ! -d "/Applications/$browser.app" ]]; then
    info "${c_y}$(tp add_no_app "$browser")${c_0}$(t add_no_app2)"
  fi

  local wrapper="" tok=""
  if (( run_setup )); then
    case "$browser" in
      "")        info "\n${c_y}$(t add_default_br)${c_0}$(tp add_default_b2 "$name")" ;;
      __clip__)  wrapper="$(mk_browser_wrapper __clip__)"; info "\n${c_b}$(t add_urlonly)${c_0}$(t add_urlonly2)" ;;
      *)         wrapper="$(mk_browser_wrapper "$browser")"; info "\n${c_b}$(tp add_browse_in "$browser")${c_0}$(t add_browse_in2)" ;;
    esac

    cat >&2 <<EOF

${c_dim}$(t add_note)${c_0}

EOF

    info "${c_dim}--- claude setup-token ---${c_0}"
    # Co y KHONG dung `</dev/tty`: da kiem chung thuc te — luong "Paste code
    # here" cua `claude setup-token` khong nhan phim/paste khi stdin bi mo
    # lai qua /dev/tty. claude-acc luon duoc goi truc tiep trong mot terminal
    # that, nen stdin da san la terminal do — mo lai la thua va gay loi nay.
    run_setup_token_capture "$wrapper" || true
    tok="$CAPTURED_TOKEN"
    [[ -n "$wrapper" ]] && rm -f "$wrapper"
    info "${c_dim}--------------------------${c_0}"

    if [[ -n "$tok" ]]; then
      info "${c_g}✓ $(t add_caught)${c_0}$(tp add_caught2 "${tok:0:14}" "${tok: -4}" "${#tok}")"
    else
      info "${c_y}$(t add_nocatch)${c_0}$(t add_nocatch2)"
    fi
  fi

  # `claude setup-token` la TUI; no co the tra terminal ve trang thai raw
  # khien `read` ben duoi khong nhan duoc gi. Dua stty ve binh thuong truoc.
  { stty sane </dev/tty; } >/dev/null 2>&1 || true

  if [[ -z "$tok" ]]; then
    case "$mode" in
      clip)  tok="$(token_from_clip)"
             [[ -n "$tok" ]] || die "$(t err_clip)"
             info "${c_dim}$(tp add_from_clip "${tok:0:14}" "${tok: -4}" "${#tok}")${c_0}" ;;
      stdin) IFS= read -r tok || true; tok="$(trim "$tok")" ;;
      *)     tok="$(read_token "$name")" ;;
    esac
  fi
  [[ -n "$tok" ]] || die "$(t err_empty_tok)"

  if [[ "$tok" != sk-ant-oat01-* ]]; then
    cat >&2 <<EOF
${c_r}Day khong phai token.${c_0} Token that bat dau bang 'sk-ant-oat01-'.
Nhieu kha nang ban dan nham ${c_b}code${c_0} — chuoi ngan browser hien ra. Do la
dau vao cua \`claude setup-token\`, khong phai ket qua.

Token la chuoi dai ma \`claude setup-token\` ${c_b}IN RA${c_0} sau khi duyet xong.
EOF
    exit 1
  fi

  security add-generic-password -U \
    -s "$SVC" -a "$name" -w "$tok" \
    -D "Claude Code account token" \
    -j "Token dang nhap Claude Code cho acc '$name' (quan ly boi claude-acc)" \
    || die "$(t err_keychain)"

  remember "$name"
  info "${c_dim}$(tp add_saved "$name")${c_0}"

  # `probe` la ham co san trong chinh script nay, subshell da thua ke duoc —
  # khong can `bash -c "$(declare -f probe); probe"`. Va export trong subshell
  # thay vi `env VAR=val cmd`: dung `env` de gan bien tao ra mot tien trinh
  # rieng ma chinh argv cua no chua token — `ps -ef` cua user khac tren may
  # doc duoc trong luc lenh chay. export/subshell khong tao tien trinh nao co
  # token trong argv ca.
  if ( export CLAUDE_CODE_OAUTH_TOKEN="$tok"; probe ) >&2; then
    info "${c_g}✓ $(tp add_ready "$name")${c_0}$(tp add_ready2 "$name")"
  else
    info "${c_r}✗ $(t add_bad)${c_0}"
    info "$(tp add_bad2 "$name")"
    return 1
  fi
}

# Doi acc cho CA Cursor/VS Code GUI lan terminal, bang khoi `env` trong
# ~/.claude/settings.json (docs: file nay duoc CHIA SE giua extension va CLI).
# Da do: khoi `env` DE LEN ca credential Keychain lan bien moi truong cua
# tien trinh — nen day la cong tac duy nhat, khong the dung song song voi
# `claude-acc run`.
#
# Da do lai 2026-09-05 (extension 2.1.260 va ca ban cu 2.1.198): CLI doc lai
# settings.json o TUNG request, khong phai mot lan luc khoi dong. Bang chung:
# doi token thanh rac giua mot phien stream-json -> luot ke tiep bao 401 ngay.
# Vi vay switch AN NGAY, khong can Reload Window — va cung vi vay no ap len
# ca nhung phien dang chay do o cua so/repo khac.
cmd_switch() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "$(t usage_switch)"

  local tok=""
  if [[ "$name" != "main" ]]; then
    valid_name "$name"
    tok="$(token_of "$name")"
  fi

  backup_settings

  # Token truyen qua bien moi truong CLAUDE_ACC_TOK (khong phai argv) de
  # khong lo qua `ps` cua user khac tren may — argv cua moi tien trinh la
  # cong khai (ps -ef), con environ thi khong. File dich duoc tao qua
  # os.open voi mode 0o600 TUONG MINH roi os.replace (atomic rename) —
  # khong bao gio co lat file ton tai o quyen long, du la file moi hay de
  # len file cu.
  CLAUDE_ACC_TOK="$tok" python3 -c '
import json,sys,os
p,name=sys.argv[1],sys.argv[2]
tok=os.environ.get("CLAUDE_ACC_TOK","")
d={}
if os.path.exists(p):
    with open(p) as f: d=json.load(f)          # loi cu phap -> nem, khong ghi de
env=d.get("env") or {}
if name=="main":
    env.pop("CLAUDE_CODE_OAUTH_TOKEN",None); env.pop("CLAUDE_ACC_NAME",None)
else:
    env["CLAUDE_CODE_OAUTH_TOKEN"]=tok; env["CLAUDE_ACC_NAME"]=name
if env: d["env"]=env
elif "env" in d: del d["env"]
tmp=p+".tmp"
fd=os.open(tmp, os.O_WRONLY|os.O_CREAT|os.O_TRUNC, 0o600)
with os.fdopen(fd,"w") as f:
    json.dump(d,f,indent=2,ensure_ascii=False); f.write("\n")
os.replace(tmp,p)
' "$SETTINGS" "$name" \
    || die "$(tp err_write_glob "$SETTINGS" "$SETTINGS.bak-claude-acc")"

  if [[ "$name" == "main" ]]; then
    info "${c_g}$(t sw_to_main)${c_0}$(t sw_to_main2)"
  else
    info "${c_g}$(tp sw_to_acc "$name")${c_0}$(t sw_to_acc2)"
    info "${c_y}$(tp sw_plain "$SETTINGS")${c_0}"
  fi
  info "${c_b}$(t sw_now)${c_0}"
  info "${c_dim}$(t sw_now2)${c_0}"
  info "${c_dim}$(t sw_now3)${c_0}"

  # ... TRU nhung thu muc da ghim rieng: ghim cap repo de len ghim toan cuc.
  # Neu dung ngay trong mot cho nhu vay ma khong noi gi, nguoi dung se tuong
  # da doi acc cho repo nay.
  local _l _gdir _gpin
  _l="$(resolve_target "$PWD" 2>/dev/null || true)"; _gdir="${_l%%$'\t'*}"
  _gpin="$(repo_pin "$(pwd -P)")"
  [[ -z "$_gpin" && -n "$_gdir" && "$_gdir" != "$(pwd -P)" ]] && _gpin="$(repo_pin "$_gdir")"
  if [[ -n "$_gpin" && "$_gpin" != "$name" ]]; then
    info ""
    info "${c_y}$(t sw_pinned)${c_0}$(tp sw_pinned2 "$_gpin")"
    info "${c_dim}$(t sw_pinned3)${c_0}"
    info "${c_dim}$(tp sw_fix1 "$name")${c_0}"
    info "${c_dim}$(t sw_fix2)${c_0}"
  fi

  info "${c_dim}$(t sw_check)${c_0}"
  cmd_check "$name"
}

# Dang nhap acc "main" (ghi vao Keychain), chon duoc browser.
# Ghim acc cho MOT THU MUC (repo hoac workspace), doc lap voi ghim toan cuc.
cmd_here() {
  local name="" at="" check=1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --at)  at="${2:-}"; [[ -n "$at" ]] || die "$(t err_at_needs)"; shift 2 ;;
      --at=*) at="${1#*=}"; shift ;;
      --no-check) check=0; shift ;;
      -*)    die "$(tp err_unknown "$1")" ;;
      *)     [[ -z "$name" ]] || die "$(tp err_one_acc "$1")"
             name="$1"; shift ;;
    esac
  done
  [[ -n "$name" ]] || die "$(t usage_here)"

  local dir note=""
  if [[ -n "$at" ]]; then
    [[ -d "$at" ]] || die "$(tp err_no_dir "$at")"
    dir="$(cd "$at" && pwd -P)"
  else
    local line; line="$(resolve_target "$PWD")"
    dir="${line%%$'\t'*}"; note="${line#*$'\t'}"
  fi

  local tok=""
  case "$name" in
    off)  ;;
    main) ;;
    *)    valid_name "$name"; tok="$(token_of "$name")" ;;
  esac

  if [[ "$name" == "off" ]]; then
    local cur; cur="$(repo_pin "$dir")"
    [[ -n "$cur" ]] || die "$(tp err_not_pinned "$dir")"
    write_repo_pin "$dir" off ""
    reg_del "$dir"
    info "${c_g}$(tp here_unpin "$dir")${c_0}"
    info "${c_dim}$(t here_unpin2)${c_0}"
    return
  fi

  guard_git "$dir"
  write_repo_pin "$dir" "$name" "$tok"
  reg_set "$dir" "$name"

  if [[ "$name" == "main" ]]; then
    info "${c_g}$(t here_main)${c_0}$(tp here_main2 "$dir")"
  else
    info "${c_g}$(tp here_acc "$name")${c_0}$(tp here_for "$dir")"
    info "${c_y}$(tp here_plain "$(repo_file "$dir")")${c_0}"
  fi
  [[ -n "$note" ]] && info "${c_dim}$(tp here_ws "$note")${c_0}" \
                   && info "${c_dim}$(t here_ws2)${c_0}"

  local here_now; here_now="$(cd "$PWD" && pwd -P)"
  if [[ "$here_now" != "$dir" ]]; then
    info "${c_dim}$(tp here_diff "$here_now")${c_0}"
    info "${c_dim}$(t here_diff2)${c_0}"
  fi

  info "${c_b}$(t here_now)${c_0}$(t here_now2)"
  [[ "$check" == 1 ]] || return 0
  info "${c_dim}$(t here_check)${c_0}"
  local out
  if out="$(cd "$dir" && env -u CLAUDE_CODE_OAUTH_TOKEN claude -p 'reply with exactly: OK' --model haiku 2>&1)" \
     && [[ "$out" == *OK* ]]; then
    info "${c_g}✓ $(tp here_ok "$name")${c_0}"
  else
    info "${c_r}✗ $(t here_fail)${c_0}"
    info "  $(printf '%s' "$out" | head -2)"
    return 1
  fi
}

# Doi hang loat: moi thu muc dang dung <cu> chuyen sang <moi>. Dung khi mot
# acc gan cham limit va muon san tai sang acc khac.
cmd_reassign() {
  local old="${1:-}" new="${2:-}"
  [[ -n "$old" && -n "$new" ]] || die "$(t usage_reassign)"
  local tok=""
  if [[ "$new" != "main" ]]; then valid_name "$new"; tok="$(token_of "$new")"; fi

  local n=0 missing=0 dir acc
  while IFS=$'\t' read -r dir acc; do
    [[ -n "$dir" ]] || continue
    [[ "$acc" == "$old" ]] || continue
    if [[ ! -d "$dir" ]]; then
      info "${c_y}$(tp ra_skip "$dir")${c_0}"; missing=$((missing+1)); continue
    fi
    guard_git "$dir"
    write_repo_pin "$dir" "$new" "$tok"
    reg_set "$dir" "$new"
    info "  $dir"
    n=$((n+1))
  done < "$REPOS"

  [[ $n -gt 0 ]] || die "$(tp ra_none "$old")"
  info "${c_g}$(tp ra_done "$n" "$old" "$new")${c_0}"
  [[ $missing -gt 0 ]] && info "${c_dim}$(tp ra_missing "$missing")${c_0}"
  info "${c_dim}$(t ra_now)${c_0}"
}

# Ghi lai token hien tai vao moi thu muc da ghim. Dung sau khi `add` lai mot
# acc (token moi) hoac khi nghi ngo file trong repo bi sua/mat.
cmd_sync() {
  local n=0 fixed=0 gone=0 dir acc
  while IFS=$'\t' read -r dir acc; do
    [[ -n "$dir" ]] || continue
    if [[ ! -d "$dir" ]]; then
      info "${c_y}$(tp sync_drop "$dir")${c_0}"
      reg_del "$dir"; gone=$((gone+1)); continue
    fi
    local tok=""
    if [[ "$acc" != "main" ]]; then
      if ! tok="$(security find-generic-password -s "$SVC" -a "$acc" -w 2>/dev/null)"; then
        info "${c_r}$(tp sync_lost "$dir" "$acc" "$acc")${c_0}"
        continue
      fi
    fi
    local before; before="$(repo_pin "$dir")"
    guard_git "$dir"
    write_repo_pin "$dir" "$acc" "$tok"
    [[ "$before" == "$acc" ]] || { info "$(tp sync_fix "$dir" "$before" "$acc")"; fixed=$((fixed+1)); }
    n=$((n+1))
  done < "$REPOS"
  info "${c_g}$(tp sync_done "$n")${c_0}"
  [[ $fixed -gt 0 ]] && info "${c_dim}$(tp sync_fixn "$fixed")${c_0}"
  [[ $gone -gt 0 ]] && info "${c_dim}$(tp sync_gonen "$gone")${c_0}"
}

# Mo cua so 5h cho nhieu acc mot luc. Cua so chi bat dau tinh tu request DAU
# TIEN, nen acc khong dung den thi khong chay gio — goi mot request re nhat
# cho tung acc la du de khoi dong.
#
# Khong the chi set CLAUDE_CODE_OAUTH_TOKEN roi goi: khoi `env` trong
# ~/.claude/settings.json DE LEN bien moi truong (da do). Nen moi acc duoc
# goi trong mot thu muc tam co .claude/settings.local.json rieng — cap repo
# de len cap user. Rieng 'main' dung token RONG: de len token thua ke roi
# roi ve Keychain.
warm_one() {
  local acc="$1" dir="$2" out_file="$3" tok="" out rc=0
  mkdir -p "$dir/.claude"
  if [[ "$acc" != "main" ]]; then
    if ! tok="$(security find-generic-password -s "$SVC" -a "$acc" -w 2>/dev/null)"; then
      printf 'ERR\t%s\n' "$(tp warm_lost "$acc")" > "$out_file"
      return
    fi
  fi
  CLAUDE_ACC_TOK="$tok" python3 - "$dir/.claude/settings.local.json" <<'PYEOF'
import json, os, sys
fd = os.open(sys.argv[1], os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as f:
    json.dump({"env": {"CLAUDE_CODE_OAUTH_TOKEN": os.environ.get("CLAUDE_ACC_TOK", "")}}, f)
PYEOF
  out="$(cd "$dir" && env -u CLAUDE_CODE_OAUTH_TOKEN claude -p 'Reply with exactly: OK' \
         --model haiku 2>&1 </dev/null)" || rc=1
  if [[ $rc -eq 0 && "$out" == *OK* ]]; then
    printf 'OK\t\n' > "$out_file"
  else
    printf 'ERR\t%s\n' "$(printf '%s' "$out" | head -1)" > "$out_file"
  fi
}

cmd_warm() {
  local accs=() a
  if [[ $# -eq 0 ]]; then
    accs+=("main")
    while IFS= read -r a; do [[ -n "$a" ]] && accs+=("$a"); done < "$LIST"
  else
    for a in "$@"; do
      case "$a" in
        -*) die "$(tp err_only_names trigger)" ;;
        main) ;;
        *)  valid_name "$a"
            known "$a" || die "$(tp err_unknown_acc "$a")" ;;
      esac
      accs+=("$a")
    done
  fi
  [[ ${#accs[@]} -gt 0 ]] || die "$(t err_no_accs)"

  local base
  base="$(mktemp -d "${TMPDIR:-/tmp}/claude-acc-warm.XXXXXX")" || die "$(t err_tmpdir)"
  chmod 700 "$base"
  # Token nam trong cac file duoi $base — don ca khi bi Ctrl+C.
  trap 'rm -rf "$base"' EXIT INT TERM

  info "${c_dim}$(tp warm_running "${#accs[@]}")${c_0}"
  for a in "${accs[@]}"; do
    warm_one "$a" "$base/$a" "$base/res.$a" &
  done
  wait

  local ok=0 bad=0 line st msg
  for a in "${accs[@]}"; do
    line="$(cat "$base/res.$a" 2>/dev/null || printf 'ERR\t%s\n' "$(t warm_noresult)")"
    st="${line%%$'\t'*}"; msg="${line#*$'\t'}"
    if [[ "$st" == "OK" ]]; then
      printf '  %s✓%s %-10s %s%s%s\n' "$c_g" "$c_0" "$a" "$c_dim" "$(t warm_opened)" "$c_0"
      ok=$((ok+1))
    else
      printf '  %s✗%s %-10s %s\n' "$c_r" "$c_0" "$a" "$msg"
      bad=$((bad+1))
    fi
  done
  rm -rf "$base"; trap - EXIT INT TERM
  info ""
  if [[ $bad -eq 0 ]]; then
    info "${c_g}$(tp warm_all_ok "$ok" "$ok")${c_0}"
  else
    info "${c_y}$(tp warm_some "$ok" "$bad")${c_0}"
    return 1
  fi
}

# Access token cua acc 'main' nam trong credential rieng cua Claude Code
# (service "Claude Code-credentials"), khong phai trong kho token cua
# claude-acc. No co han ngan va do chinh Claude Code lam moi.
main_access_token() {
  local raw
  raw="$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null)" || return 1
  # QUAN TRONG: script python den tu heredoc => no CHIEM stdin. Pipe them du
  # lieu vao day se khong toi noi (json.load(sys.stdin) doc phai chinh script,
  # hoac rong). Nen JSON di qua bien moi truong.
  CLAUDE_ACC_RAW="$raw" python3 - <<'PYEOF'
import json, os, sys
try:
    d = json.loads(os.environ.get("CLAUDE_ACC_RAW", ""))
except Exception:
    sys.exit(1)
tok = (d.get("claudeAiOauth") or {}).get("accessToken") or ""
if not tok:
    sys.exit(1)
print(tok)
PYEOF
}

# Hoi API mot cau re nhat va doc HEADERS — so lieu han muc chi nam o do,
# khong co lenh CLI nao in ra. Token di qua BIEN MOI TRUONG chu khong qua
# argv: argv cua moi tien trinh la cong khai voi `ps`.
# accessToken cua 'main' chi song vai gio va do CHINH Claude Code lam moi
# (no giu refreshToken). Doc thang tu Keychain nen co the vo phai ban da het
# han -> 401. Cach lam moi: chay mot request qua `claude`, no tu doi token
# moi roi ghi lai vao Keychain; sau do doc lai la dung.
refresh_main_token() {
  local d; d="$(mktemp -d "${TMPDIR:-/tmp}/claude-acc-refresh.XXXXXX")" || return 1
  chmod 700 "$d"; mkdir -p "$d/.claude"
  # token RONG o cap thu muc: de len token thua ke, buoc `claude` dung Keychain
  printf '{"env":{"CLAUDE_CODE_OAUTH_TOKEN":""}}' > "$d/.claude/settings.local.json"
  chmod 600 "$d/.claude/settings.local.json"
  (cd "$d" && env -u CLAUDE_CODE_OAUTH_TOKEN claude -p 'hi' --model haiku >/dev/null 2>&1) || true
  rm -rf "$d"
}

usage_probe() {
  CLAUDE_ACC_TOK="$1" T_EXPIRED="$(t usg_expired)" python3 - > "$2" <<'PYEOF'
import json, os, sys, urllib.request, urllib.error

body = json.dumps({"model": "claude-haiku-4-5-20251001", "max_tokens": 1,
                   "messages": [{"role": "user", "content": "hi"}]}).encode()
req = urllib.request.Request("https://api.anthropic.com/v1/messages", data=body, headers={
    "Authorization": "Bearer " + os.environ["CLAUDE_ACC_TOK"],
    "anthropic-version": "2023-06-01",
    "anthropic-beta": "oauth-2025-04-20",
    "content-type": "application/json",
})
code, h = 0, None
try:
    r = urllib.request.urlopen(req, timeout=60)
    code, h = r.status, r.headers
except urllib.error.HTTPError as e:
    # 429 = het han muc: van tra ve day du headers, van doc duoc.
    code, h = e.code, e.headers
except Exception as e:
    print("ERR\t%s" % str(e)[:70]); sys.exit()

def g(name, default=""):
    return h.get("anthropic-ratelimit-unified-" + name, default) if h else default

if code == 401 or code == 403:
    print("EXPIRED\t" + (os.environ.get("T_EXPIRED") or "HTTP %s - token no longer usable") % code)
    sys.exit()
if not g("5h-status") and code >= 400:
    print("ERR\tHTTP %d" % code); sys.exit()

print("\t".join(["OK", g("5h-utilization", "?"), g("5h-reset", "0"), g("5h-status", "?"),
                 g("7d-utilization", "?"), g("7d-reset", "0"), g("7d-status", "?"),
                 g("overage-status", "")]))
PYEOF
}

usage_one() {
  local acc="$1" out_file="$2" tok=""
  if [[ "$acc" == "main" ]]; then
    tok="$(main_access_token)" || { printf 'ERR\t%s\n' "$(t usg_nocred)" > "$out_file"; return; }
  else
    tok="$(security find-generic-password -s "$SVC" -a "$acc" -w 2>/dev/null)" \
      || { printf 'ERR\t%s\n' "$(tp warm_lost "$acc")" > "$out_file"; return; }
  fi

  usage_probe "$tok" "$out_file"

  # 'main' het han thi khong phai hong — chi la accessToken ngan han da qua
  # han. Nho Claude Code lam moi mot lan roi hoi lai, thay vi bao loi.
  if [[ "$acc" == "main" ]] && head -c 7 "$out_file" 2>/dev/null | grep -q '^EXPIRED'; then
    refresh_main_token
    tok="$(main_access_token)" || return
    usage_probe "$tok" "$out_file"
  fi
}

cmd_usage() {
  local accs=() a
  if [[ $# -eq 0 ]]; then
    accs+=("main")
    while IFS= read -r a; do [[ -n "$a" ]] && accs+=("$a"); done < "$LIST"
  else
    for a in "$@"; do
      case "$a" in
        -*)   die "$(tp err_only_names usage)" ;;
        main) ;;
        *)    valid_name "$a"; known "$a" || die "$(tp err_unknown_acc "$a")" ;;
      esac
      accs+=("$a")
    done
  fi

  local base; base="$(mktemp -d "${TMPDIR:-/tmp}/claude-acc-usage.XXXXXX")" || die "$(t err_tmpdir)"
  chmod 700 "$base"
  trap 'rm -rf "$base"' EXIT INT TERM

  info "${c_dim}$(tp usg_running "${#accs[@]}")${c_0}"
  info "${c_y}$(t usg_warn)${c_0}"
  for a in "${accs[@]}"; do usage_one "$a" "$base/res.$a" & done
  wait

  printf '\n'
  T_ACC="$(t usg_hdr_acc)" T_5H="$(t usg_hdr_5h)" T_7D="$(t usg_hdr_7d)" \
  T_OUT="$(t usg_out)" T_BACK="$(t usg_out_back)" T_SHORT="$(t usg_out_short)" \
  T_LEFT="$(t usg_left)" T_DAYS="$(t usg_days)" T_DAYH="$(t usg_day_h)" \
  T_MOST="$(t usg_most)" T_MOST2="$(t usg_most2)" T_MOST3="$(t usg_most3)" \
  python3 - "$base" "${accs[@]}" <<'PYEOF'
import os, sys, time

G, R, Y, D, Z = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"
base, names = sys.argv[1], sys.argv[2:]

def E(key, fallback):
    return os.environ.get(key) or fallback

def read(n):
    try:
        return open(os.path.join(base, "res." + n)).read().strip()
    except Exception:
        return "ERR\tkhong co ket qua"

def left_of(ts):
    try:
        ts = int(ts)
    except Exception:
        return None
    return ts - int(time.time()) if ts > 0 else None

def short(ts, with_date=False):
    """13:40 (con 3h33)  /  11/09 (con 6 ngay)"""
    lf = left_of(ts)
    if lf is None:
        return ""
    t = time.localtime(int(ts))
    when = time.strftime("%d/%m" if with_date else "%H:%M", t)
    if lf <= 0:
        return when
    d, rem = divmod(lf, 86400)
    h, m = divmod(rem // 60, 60)
    if d >= 2:
        gap = E("T_DAYS", "%s days") % d
    elif d == 1:
        gap = E("T_DAYH", "1 day %sh") % h
    elif h:
        gap = "%dh%02d" % (h, m)
    else:
        gap = "%dm" % m
    return "%s (%s)" % (when, E("T_LEFT", "%s left") % gap)

ANSI = __import__("re").compile("\033\\[[0-9;]*m")

def pad_vis(text, width):
    """Padding tinh theo do dai NHIN THAY — ma mau ANSI khong chiem cot."""
    return text + " " * max(0, width - len(ANSI.sub("", text)))

def pct(u):
    try:
        return float(u)
    except Exception:
        return None

def cell(u):
    v = pct(u)
    if v is None:
        return "??????????   ?%"
    n = max(0, min(10, int(round(v * 10))))
    return "%s %3d%%" % ("#" * n + "." * (10 - n), round(v * 100))

print("%s  %-10s %-30s %s%s" % (Y, E("T_ACC", "account"),
                                 E("T_5H", "5-hour window"), E("T_7D", "7-day window"), Z))
best = []
for name in names:
    f = read(name).split("\t")
    if f[0] != "OK":
        note = f[1] if len(f) > 1 else ""
        print("  %s%-10s%s %s%s%s" % (R, name, Z, D, note, Z))
        continue
    u5, r5, s5, u7, r7, s7 = f[1], f[2], f[3], f[4], f[5], f[6]
    ok = (s5 == "allowed" and s7 == "allowed")
    if s5 != "allowed":
        five = "%s%s%s  %s" % (R, E("T_OUT", "LIMIT REACHED"), Z,
                               E("T_BACK", "back at %s") % short(r5))
    else:
        five = "%s  %s" % (cell(u5), short(r5))
    seven = ("%s%s%s" % (R, E("T_SHORT", "OUT"), Z)) if s7 != "allowed" else "%3d%%  %s" % (
        round((pct(u7) or 0) * 100), short(r7, with_date=True))
    mark = "%s*%s" % (G, Z) if ok else "%s!%s" % (R, Z)
    print(" %s %-10s %s %s" % (mark, name, pad_vis(five, 30), seven))
    if ok and pct(u5) is not None:
        best.append((pct(u5), name))

if len(best) > 1:
    best.sort()
    print("\n%s%s %s%s%s%s" % (D, E("T_MOST", "Most headroom:"), Z, best[0][1], D,
                               E("T_MOST2", " (5h only %s%%%% used)") % round(best[0][0] * 100)))
    print("%s%s" % (E("T_MOST3", "  -> use it here:  claude-acc switch %s --here") % best[0][1], Z))
PYEOF
  rm -rf "$base"; trap - EXIT INT TERM
}

cmd_lang() {
  local want="${1:-}"
  if [[ -z "$want" ]]; then
    local src="tu LANG cua he thong"
    [[ -s "$LANGFILE" ]] && src="$(t lang_src_file)"
    [[ -s "$LANGFILE" ]] || src="$(t lang_src_auto)"
    info "$(tp lang_current "$ACC_LANG" "$src")"
    info "${c_dim}$(t lang_howto)${c_0}"
    return
  fi
  case "$want" in
    vi|en)
      printf '%s\n' "$want" > "$LANGFILE"
      ACC_LANG="$want"
      info "${c_g}$(tp lang_set "$want")${c_0}"
      ;;
    auto)
      rm -f "$LANGFILE"
      ACC_LANG="$(acc_lang)"
      info "${c_g}$(tp lang_set_auto "$ACC_LANG")${c_0}"
      ;;
    *) die "$(t lang_bad)" ;;
  esac
}

cmd_login() {
  local browser=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --browser)  browser="${2:-}"
                  [[ -n "$browser" ]] || die "$(t err_br_app2)"
                  [[ "$browser" != -* ]] || die "$(tp err_br_bad "$browser")"
                  shift 2 ;;
      --url-only) browser="__clip__"; shift ;;
      *)          die "$(t usage_login)" ;;
    esac
  done

  info "${c_y}$(t login_warn)${c_0}$(t login_warn2)"
  info "$(t login_warn3)"

  local wrapper=""
  [[ -n "$browser" ]] && wrapper="$(mk_browser_wrapper "$browser")"
  [[ -n "$browser" && "$browser" != "__clip__" ]] && info "${c_b}$(tp add_browse_in "$browser")${c_0}"

  # Khong dung `</dev/tty`: xem giai thich trong cmd_add() — mo lai stdin qua
  # /dev/tty lam luong "Paste code here" cua claude khong nhan duoc phim/paste.
  if [[ -n "$wrapper" ]]; then
    BROWSER="$wrapper" claude auth login || true
    rm -f "$wrapper"
  else
    claude auth login || true
  fi

  { stty sane </dev/tty; } >/dev/null 2>&1 || true
  info "\n${c_dim}$(t login_result)${c_0}"
  cmd_check main
}

cmd_rm() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "$(t usage_rm)"
  valid_name "$name"
  security delete-generic-password -s "$SVC" -a "$name" >/dev/null 2>&1 \
    || info "${c_y}$(tp rm_notfound "$name")${c_0}"
  forget "$name"
  if [[ "$(pinned_acc)" == "$name" ]]; then
    info "${c_y}$(tp rm_pinned "$name")${c_0}"
    cmd_switch main >&2 || true
  fi
  info "${c_g}$(tp rm_done "$name")${c_0}"
}

cmd_ls() {
  local who
  who="$(env -u CLAUDE_CODE_OAUTH_TOKEN bash -c 'claude auth status --json 2>/dev/null' | python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: print(""); sys.exit()
def walk(o):
    if isinstance(o,dict):
        for k,v in o.items():
            if k.lower() in ("email","emailaddress","account_email") and isinstance(v,str): return v
            r=walk(v)
            if r: return r
    elif isinstance(o,list):
        for v in o:
            r=walk(v)
            if r: return r
    return None
print(walk(d) or "")
' 2>/dev/null || true)"

  local pin; pin="$(pinned_acc)"
  printf '%s%s%s  %s  %s(~/.claude/settings.json)%s\n' \
    "$c_b" "$(t ls_global)" "$c_0" "${pin:-main}" "$c_dim" "$c_0"

  # Chay claude o THU MUC NAY thi acc nao that su co hieu luc? Settings cap
  # repo chi an o dung thu muc chua .claude/, nen phai hoi theo tung thu muc.
  local hp; hp="$(repo_pin "$(pwd -P)")"
  if [[ -n "$hp" ]]; then
    printf '%s%s%s  %s  %s(%s)%s\n' \
      "$c_b" "$(t ls_here)" "$c_0" "$hp" "$c_dim" "$(tp ls_pin_of "$(pwd -P)")" "$c_0"
  else
    printf '%s%s%s  %s  %s(%s)%s\n' \
      "$c_b" "$(t ls_here)" "$c_0" "${pin:-main}" "$c_dim" "$(t ls_nopin)" "$c_0"
  fi

  # GUI cua Cursor/VS Code chay o folder [0] cua workspace, khong phai o thu
  # muc ban dang dung — neu hai cho lech nhau thi noi ro.
  local line gdir gnote gpin
  line="$(resolve_target "$PWD" 2>/dev/null || true)"
  gdir="${line%%$'\t'*}"; gnote="${line#*$'\t'}"
  if [[ -n "$gdir" && "$gdir" != "$(pwd -P)" ]]; then
    gpin="$(repo_pin "$gdir")"
    printf '%s%s%s  %s  %s(%s%s)%s\n' \
      "$c_b" "$(t ls_gui)" "$c_0" "${gpin:-${pin:-main}}" "$c_dim" "$gdir" "${gnote:+ — $gnote}" "$c_0"
  fi
  printf '\n'

  printf '%smain%s  %s(%s)%s\n' \
    "$c_b" "$c_0" "$c_dim" "$(t ls_main_desc)" "$c_0"
  [[ -n "$who" ]] && printf '        %s%s%s\n' "$c_dim" "$who" "$c_0"

  if [[ -s "$LIST" ]]; then
    printf '\n%s%s%s %s(%s)%s\n' "$c_b" "$(t ls_sub)" "$c_0" "$c_dim" "$(t ls_sub_desc)" "$c_0"
    while IFS= read -r a; do
      [[ -n "$a" ]] || continue
      if security find-generic-password -s "$SVC" -a "$a" -w >/dev/null 2>&1; then
        printf '  %s✓%s %s\n' "$c_g" "$c_0" "$a"
      else
        printf '  %s✗%s %s %s(%s)%s\n' "$c_r" "$c_0" "$a" "$c_dim" "$(tp ls_lost_tok "$a")" "$c_0"
      fi
    done < "$LIST"
  else
    printf '\n%s%s%s\n' "$c_dim" "$(t ls_none)" "$c_0"
  fi

  if [[ -s "$REPOS" ]]; then
    printf '\n%s%s%s %s(%s)%s\n' "$c_b" "$(t ls_pins)" "$c_0" "$c_dim" "$(t ls_pins_hint)" "$c_0"
    local d a mark
    while IFS=$'\t' read -r d a; do
      [[ -n "$d" ]] || continue
      mark=" "
      [[ "$d" == "$(pwd -P)" ]] && mark="*"
      if [[ -d "$d" ]]; then
        printf '  %s %-8s %s\n' "$mark" "$a" "${d/#$HOME/~}"
      else
        printf '  %s %-8s %s %s(%s)%s\n' \
          "$mark" "$a" "${d/#$HOME/~}" "$c_dim" "$(t ls_dir_gone)" "$c_0"
      fi
    done < "$REPOS"
  fi
}

cmd_run() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "$(t usage_run)"
  shift
  [[ "${1:-}" == "--" ]] && shift

  # Khoi `env` trong settings.json de len bien moi truong (da do), nen khi da
  # ghim thi `run` khong doi duoc acc nua — bao thang thay vi chay sai am tham.
  # Ghim cap thu muc de len ca ghim toan cuc lan bien moi truong, nen phai
  # kiem no TRUOC — neu khong `run` se chay sai acc mot cach am tham.
  local hpin; hpin="$(repo_pin "$(pwd -P)")"
  if [[ -n "$hpin" && "$hpin" != "$name" ]]; then
    die "$(tp run_dirpin "$hpin" "$(repo_file "$(pwd -P)")" "$name")"
  fi

  local pin; pin="$(pinned_acc)"
  if [[ -n "$pin" && -z "$hpin" && "$pin" != "$name" ]]; then
    if [[ "$name" == "main" ]]; then
      die "$(tp run_glbpin "$pin" "$(t run_fix_main)")"
    else
      die "$(tp run_glbpin "$pin" "$(tp run_fix_acc "$name")")"
    fi
  fi

  if [[ "$name" == "main" ]]; then
    exec env -u CLAUDE_CODE_OAUTH_TOKEN claude "$@"
  fi
  valid_name "$name"
  # QUAN TRONG: gan tok o mot dong RIENG truoc khi dung. Neu nhet thang
  # "$(token_of "$name")" vao lam gia tri cho bien cua `env`, exit code cua
  # token_of (goi die/exit 1 khi khong co token) bi NUOT MAT — `env ...` van
  # duoc coi la mot lenh don, thanh cong, va chay `claude` voi token RONG
  # thay vi dung lai. Tach dong nay de set -e bat duoc loi that.
  local tok; tok="$(token_of "$name")"
  export CLAUDE_CODE_OAUTH_TOKEN="$tok"
  exec claude "$@"
}

cmd_env() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "$(t usage_env)"
  if [[ "$name" == "main" ]]; then
    printf 'unset CLAUDE_CODE_OAUTH_TOKEN\n'
    return
  fi
  valid_name "$name"
  # Tach dong: xem giai thich trong cmd_run() — nhet truc tiep vao %q se nuot
  # mat loi cua token_of, in ra mot dong `export ...=''` nhin nhu hop le.
  local tok; tok="$(token_of "$name")"
  printf 'export CLAUDE_CODE_OAUTH_TOKEN=%q\n' "$tok"
}

cmd_check() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "$(t usage_check)"

  if [[ "$name" == "main" ]]; then
    env -u CLAUDE_CODE_OAUTH_TOKEN claude auth status --text
    printf '%s%s%s\n' "$c_dim" "$(t trying_real)" "$c_0" >&2
    if ( unset CLAUDE_CODE_OAUTH_TOKEN; probe ); then
      printf '%s✓ %s%s\n' "$c_g" "$(t chk_main_ok)" "$c_0"
    else
      printf '%s✗ %s%s%s\n' "$c_r" "$(t chk_main_bad)" "$c_0" "$(t chk_main_bad2)"
      return 1
    fi
    return
  fi

  valid_name "$name"
  local tok; tok="$(token_of "$name")"
  ( export CLAUDE_CODE_OAUTH_TOKEN="$tok"; claude auth status --text )
  printf '%s%s%s\n' "$c_dim" "$(t trying_real)" "$c_0" >&2
  if ( export CLAUDE_CODE_OAUTH_TOKEN="$tok"; probe ); then
    printf '%s✓ %s%s\n' "$c_g" "$(tp chk_ok "$name")" "$c_0"
  else
    printf '%s✗ %s%s%s\n' \
      "$c_r" "$(tp chk_bad "$name")" "$c_0" "$(tp chk_bad2 "$name")"
    return 1
  fi
}

cmd_uninstall() {
  info "${c_b}$(t un_willremove)${c_0}"
  [[ -s "$LIST" ]] && while IFS= read -r a; do [[ -n "$a" ]] && info "$(tp un_tok "$a")"; done < "$LIST"
  info "$(tp un_cfg "$CFG_DIR")"
  if [[ -s "$REPOS" ]]; then
    while IFS=$'\t' read -r _d _a; do
      [[ -n "$_d" ]] && info "$(tp un_pin "$(repo_file "$_d")")"
    done < "$REPOS"
  fi
  [[ -n "$(pinned_acc)" ]] && info "$(tp un_glob "$SETTINGS")"
  [[ -f "$SETTINGS.bak-claude-acc" ]] && info "$(tp un_bak "$SETTINGS.bak-claude-acc")"
  local self; self="$(command -v claude-acc 2>/dev/null || printf '%s' "$0")"
  info "${c_dim}$(tp un_self "$self")${c_0}"

  local yn
  read -r -p "$(t un_confirm)" yn </dev/tty || true
  [[ "${yn:-n}" == [yY]* ]] || { info "$(t un_cancel)"; return 1; }

  if [[ -s "$LIST" ]]; then
    while IFS= read -r a; do
      [[ -n "$a" ]] || continue
      security delete-generic-password -s "$SVC" -a "$a" >/dev/null 2>&1 || true
    done < "$LIST"
  fi
  # Token con nam DANG VAN BAN trong tung thu muc da ghim — phai don TRUOC
  # khi xoa $CFG_DIR, vi so dang ky (duong di toi cac file do) nam trong do.
  if [[ -s "$REPOS" ]]; then
    while IFS=$'\t' read -r _d _a; do
      [[ -n "$_d" && -d "$_d" ]] || continue
      write_repo_pin "$_d" off "" 2>/dev/null || info "${c_y}$(tp un_cantclean "$(repo_file "$_d")")${c_0}"
    done < "$REPOS"
  fi
  [[ -n "$(pinned_acc)" ]] && cmd_switch main >&2 || true
  # cmd_switch main o tren TU TAO mot ban backup moi (chua token cua acc vua
  # bo ghim) truoc khi xoa no o day — khong bo sot buoc nay, neu khong token
  # cuoi cung van song trong file .bak du nguoi dung tuong da xoa sach.
  rm -f "$SETTINGS.bak-claude-acc"
  rm -rf "$CFG_DIR"
  info "${c_g}$(t un_done)${c_0}$(t un_done2)"
}

cmd_help() { if [[ "$ACC_LANG" == "vi" ]]; then help_vi; else help_en; fi; }

help_vi() {
  cat <<EOF
${c_b}claude-acc${c_0} v${VERSION} — nhiều account Claude Code trên một máy, không phải login lại

${c_b}LỆNH${c_0}
  add <tên> [tùy chọn]   Thêm acc phụ: chạy \`claude setup-token\`, lưu token vào Keychain
      --browser <app>      Duyệt trong app này thay vì browser mặc định
                           (vd: "Google Chrome" | "Safari" | "Brave Browser")
      --url-only           Không mở browser; COPY URL duyệt vào clipboard để tự dán
      --stdin              Đọc token từ stdin:  pbpaste | claude-acc add x --stdin
      --clip               Lấy token từ clipboard, không hỏi gì
      --no-setup           Bỏ qua bước sinh token (khi đã có token sẵn)
  switch <tên|main>      Đổi acc cho CẢ Cursor/VS Code GUI lẫn terminal, ĂN NGAY
                         — không cần Reload Window. ĐÂY LÀ LỆNH CHÍNH ĐỂ ĐỔI ACC.
                         Lưu ý: áp ngay cho CẢ CÁC PHIÊN ĐANG CHẠY ở mọi repo.
  switch <tên|main|off> --here
                         Như trên, nhưng CHỈ cho repo/workspace bạn đang dùng
                         — để mỗi repo một acc, khỏi dồn limit vào một acc.
                         \`off\` = bỏ ghim riêng, quay về theo acc toàn cục.
      --at <thư-mục>       ghim cho thư mục khác thay vì thư mục hiện tại
      --no-check           bỏ qua bước gọi thử API sau khi ghim
  trigger [tên...]       Mở cửa sổ 5h cho các acc (mặc định: TẤT CẢ, kể cả main)
                         bằng một request nhỏ, chạy song song. Nêu tên acc để
                         chỉ trigger đúng những acc đó.
  usage [tên...]         Xem đã tiêu bao nhiêu % cửa sổ 5h / 7 ngày và bao giờ
                         reset, cho từng acc (mặc định: TẤT CẢ). Chính việc hỏi
                         cũng là một request nên CŨNG mở cửa sổ 5h của acc đó.
  reassign <cũ> <mới>    Chuyển MỌI thư mục đang ghim <cũ> sang <mới>
  sync                   Ghi lại token cho mọi thư mục đã ghim (sau khi \`add\`
                         lại một acc, hoặc khi nghi file trong repo bị sửa)
  ls                     Liệt kê acc, acc nào đang có hiệu lực ở đâu
  check <tên|main>       Gọi một request thật để xác nhận acc đó còn dùng được
  lang [vi|en|auto]      Xem hoặc đổi ngôn ngữ của claude-acc
  login [--browser <app>]  Đăng nhập acc "main" (ghi đè Keychain), chọn browser
  rm <tên>               Xóa acc phụ khỏi Keychain
  run <tên|main> [-- args]  (nâng cao) Chạy claude bằng acc đó CHỈ CHO LỆNH NÀY,
                         không đổi acc đang ghim. Lỗi nếu đang có acc khác ghim.
  env <tên|main>         (nâng cao) In lệnh export để đổi acc cho SHELL HIỆN TẠI:
                           eval "\$(claude-acc env tên-acc)"
  uninstall              Xóa toàn bộ token trong Keychain và cấu hình của claude-acc
  version, -v            In phiên bản
  help, -h               In hướng dẫn này

${c_b}BẮT ĐẦU NHANH${c_0}
  claude-acc add ca-nhan --browser "Safari"   # duyệt trong browser đang login acc đó
  claude-acc switch ca-nhan                   # đổi acc cho cả terminal lẫn GUI
  claude                                      # dùng claude như bình thường
  claude-acc switch main                      # đổi về acc chính

  cd <repo> && claude-acc switch ca-nhan --here   # riêng repo này dùng acc khác
  claude-acc switch main --here                  # riêng repo này dùng main
  claude-acc switch off --here                   # bỏ ghim riêng của repo
  claude-acc reassign ca-nhan acc-2           # acc-1 gần hết limit -> san tải

  claude-acc usage                            # acc nào còn nhiều hạn mức nhất
  claude-acc trigger                          # mở cửa sổ 5h cho TẤT CẢ acc
  claude-acc trigger ca-nhan acc-2            # chỉ 2 acc này (bỏ qua acc công ty)

${c_b}GHIM THEO THƯ MỤC — hai điều PHẢI biết (đều đã đo, không phải suy đoán)${c_0}
  - Settings cấp repo chỉ ăn khi \`claude\` chạy ĐÚNG ở thư mục chứa .claude/.
    Chạy từ thư mục con KHÔNG kế thừa — \`cd apps/web && claude\` sẽ âm thầm
    dùng acc toàn cục. \`claude-acc ls\` cho biết acc nào thật sự có hiệu lực.
  - Trong Cursor/VS Code multi-root workspace, MỌI tab chat đều chạy ở folder
    [0] của file .code-workspace, kể cả khi tab đó làm việc trên worktree
    khác. Nên ghim áp cho CẢ workspace, không riêng một worktree — và
    \`--here\` tự nhắm vào folder [0] thay vì thư mục bạn đang đứng.

${c_b}LƯU Ý${c_0}
  - Chỉ acc "main" có claude.ai connectors, Remote Control và /schedule.
    Chọn acc dùng nhiều nhất làm main.
  - \`claude setup-token\` KHÔNG ghi vào Keychain của acc "main" — thêm acc phụ
    không bao giờ làm mất đăng nhập của acc chính. Chỉ \`claude-acc login\` mới
    ghi đè Keychain.
  - Token \`setup-token\` sống 1 năm. Hết hạn thì \`claude-acc add <tên>\` lại.
  - \`switch\` ghi token DẠNG VĂN BẢN vào ~/.claude/settings.json (quyền 600) vì
    Cursor/VS Code đọc credential từ đó, không đọc được Keychain riêng theo acc.
  - History/session dùng chung giữa các acc (không tách CLAUDE_CONFIG_DIR).
EOF
}

help_en() {
  cat <<EOF
${c_b}claude-acc${c_0} v${VERSION} — several Claude Code accounts on one Mac, without logging in again

${c_b}COMMANDS${c_0}
  add <name> [options]   Add a token account: runs \`claude setup-token\`, stores it in the Keychain
      --browser <app>      Browse in this app instead of your default browser
                           (e.g. "Google Chrome" | "Safari" | "Brave Browser")
      --url-only           Do not open a browser; COPY the auth URL to the clipboard
      --stdin              Read the token from stdin:  pbpaste | claude-acc add x --stdin
      --clip               Take the token from the clipboard, no prompts
      --no-setup           Skip generating a token (when you already have one)
  switch <name|main>     Change the account for BOTH the Cursor/VS Code GUI and the
                         terminal, IN EFFECT NOW — no Reload Window. THE MAIN COMMAND.
                         Note: it also moves sessions ALREADY RUNNING, in every repo.
  switch <name|main|off> --here
                         The same, but ONLY for the repo/workspace you are in —
                         one account per repo, so no single account takes the
                         whole load. \`off\` drops the pin and follows the global one.
      --at <dir>           pin another directory instead of the current one
      --no-check           skip the verifying API call after pinning
  trigger [name...]      Start the 5-hour window for accounts (default: ALL of them,
                         main included) with one small request each, in parallel.
                         Name accounts to start only those.
  usage [name...]        Show how much of the 5h / 7d window each account has used
                         and when it resets (default: ALL). Asking is itself a
                         request, so it ALSO starts that window.
  reassign <old> <new>   Move EVERY directory pinned to <old> over to <new>
  sync                   Rewrite the token in every pinned directory (after adding
                         an account again, or if a repo file looks edited)
  ls                     List accounts, and which one is in effect where
  check <name|main>      Make a real request to confirm an account still works
  lang [vi|en|auto]      Show or change the language claude-acc speaks
  login [--browser <app>]  Sign in the "main" account (overwrites the Keychain)
  rm <name>              Remove a token account from the Keychain
  run <name|main> [-- args]  (advanced) Run claude under that account FOR THIS
                         COMMAND ONLY. Errors out if another account is pinned.
  env <name|main>        (advanced) Print an export line for THIS SHELL only:
                           eval "\$(claude-acc env name)"
  uninstall              Remove every token and all claude-acc configuration
  version, -v            Print the version
  help, -h               Print this help

${c_b}QUICK START${c_0}
  claude-acc add work --browser "Safari"      # browse where that account is signed in
  claude-acc switch work                      # change account for terminal and GUI
  claude                                      # use claude as usual
  claude-acc switch main                      # back to the main account

  cd <repo> && claude-acc switch work --here     # this repo uses a different account
  claude-acc switch main --here                  # this repo uses main
  claude-acc switch off --here                   # drop this repo's pin
  claude-acc reassign work other               # work is near its limit -> spread out

  claude-acc usage                            # which account has the most headroom
  claude-acc trigger                          # start the 5-hour window on ALL accounts
  claude-acc trigger work other               # only these two

${c_b}DIRECTORY PINS — two things you MUST know (both measured, not assumed)${c_0}
  - Repo-level settings only apply when \`claude\` runs in the exact directory
    holding .claude/. They do NOT cascade into subdirectories — \`cd apps/web
    && claude\` silently uses the global account. \`claude-acc ls\` shows what
    is really in effect where you stand.
  - In a Cursor/VS Code multi-root workspace, EVERY chat tab runs in folder
    [0] of the .code-workspace file, even a tab working on another worktree.
    So a pin covers the WHOLE workspace, not one worktree — and \`--here\`
    aims at folder [0] rather than the directory you happen to be in.

${c_b}NOTES${c_0}
  - Only "main" has claude.ai connectors, Remote Control and /schedule.
    Make your most-used account main.
  - \`claude setup-token\` never writes to the "main" Keychain entry, so adding
    a token account can never log the main one out. Only \`claude-acc login\`
    overwrites the Keychain.
  - \`setup-token\` credentials last about a year. When one expires, run
    \`claude-acc add <name>\` again.
  - \`switch\` writes the token in PLAIN TEXT into ~/.claude/settings.json
    (mode 600), because Cursor/VS Code read credentials from there and cannot
    read a per-account Keychain entry.
  - History and sessions are shared across accounts (CLAUDE_CONFIG_DIR is not
    split per account).
EOF
}

# ---------- dispatch ------------------------------------------------------

case "${1:-help}" in
  add)                shift; cmd_add "$@" ;;
  here|pin)           shift; cmd_here "$@" ;;
  trigger|warm)       shift; cmd_warm "$@" ;;
  usage|quota)        shift; cmd_usage "$@" ;;
  lang|language)      shift; cmd_lang "$@" ;;
  reassign)           shift; cmd_reassign "$@" ;;
  sync)               shift; cmd_sync "$@" ;;
  switch|use)
    shift
    # `switch <ten> --here` la cach viet khac cua `here <ten>`
    if printf '%s\n' "$@" | grep -qx -- '--here'; then
      _args=()
      for _x in "$@"; do [[ "$_x" == "--here" ]] || _args+=("$_x"); done
      # ${a[@]} tren mang RONG lam `set -u` nem "unbound variable" — phai dung
      # dang ${a[@]+...} de cmd_here con kip in huong dan dung lenh.
      cmd_here ${_args[@]+"${_args[@]}"}
    else
      cmd_switch "$@"
    fi
    ;;
  login)              shift; cmd_login "$@" ;;
  rm|remove|del)      shift; cmd_rm "$@" ;;
  ls|list)            shift; cmd_ls "$@" ;;
  run|exec)           shift; cmd_run "$@" ;;
  env)                shift; cmd_env "$@" ;;
  check|status)       shift; cmd_check "$@" ;;
  uninstall)          shift; cmd_uninstall "$@" ;;
  version|-v|--version) printf 'claude-acc %s\n' "$VERSION" ;;
  help|-h|--help)     cmd_help ;;
  *)                  die "$(tp err_unknown_cmd "$1")" ;;
esac
