#!/usr/bin/env bash
# claude-acc — quản lý nhiều account Claude Code trên một máy (macOS)
#
# Mô hình:
#   - 1 acc "main"  : đăng nhập bằng `claude auth login`, credential nằm trong
#                     macOS Keychain. Đây là acc DUY NHẤT có claude.ai
#                     connectors, Remote Control và /schedule.
#   - N acc phụ     : mỗi acc một long-lived OAuth token (`claude setup-token`,
#                     hạn 1 năm), cất trong Keychain dưới service riêng và nạp
#                     qua biến môi trường CLAUDE_CODE_OAUTH_TOKEN khi chạy,
#                     hoặc qua khối `env` của ~/.claude/settings.json khi cần
#                     áp dụng cho cả GUI (Cursor/VS Code).
#
# Vì acc phụ không bao giờ ghi vào credential của Claude Code, việc đổi qua lại
# không làm mất đăng nhập của acc nào — hết bắt login/OTP lại.

set -euo pipefail

VERSION="1.0.0"
SVC="claude-code-token"
CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/claude-acc"
LIST="$CFG_DIR/accounts"
REPOS="$CFG_DIR/repos"
LANGFILE="$CFG_DIR/lang"
# Cho phep tro sang file khac de kiem thu ma khong dung vao acc that dang
# dung. Bo trong -> dung file that.
SETTINGS="${CLAUDE_ACC_SETTINGS:-$HOME/.claude/settings.json}"

# ---------- ngon ngu / language -------------------------------------------
#
# bash 3.2 (ban macOS mac dinh) khong co mang ket hop, nen bang chuoi la mot
# `case` — dai hon nhung chay duoc o moi may, khong doi nguoi dung cai bash 4.
#
# Chon ngon ngu: file cau hinh > bien LANG/LC_ALL cua he thong > tieng Anh.
acc_lang() {
  if [[ -s "$LANGFILE" ]]; then
    local l; l="$(tr -d ' \n' < "$LANGFILE")"
    case "$l" in vi|en) printf '%s' "$l"; return ;; esac
  fi
  case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in
    vi*|*_VN*|*vi_VN*) printf 'vi' ;;
    *)                 printf 'en' ;;
  esac
}
ACC_LANG="$(acc_lang)"

# t <key>       -> in ra chuoi thuan (khong mau, khong xuong dong)
# tp <key> ...  -> nhu printf, dung cho chuoi co %s
t()  { if [[ "$ACC_LANG" == "vi" ]]; then t_vi "$1"; else t_en "$1"; fi; }
tp() { local f; f="$(t "$1")"; shift; printf "$f" "$@"; }

c_dim=$'\033[2m'; c_b=$'\033[1m'; c_r=$'\033[31m'; c_g=$'\033[32m'; c_y=$'\033[33m'; c_0=$'\033[0m'
if [[ ! -t 1 ]]; then c_dim=; c_b=; c_r=; c_g=; c_y=; c_0=; fi

# ---------- bang chuoi / string catalog -----------------------------------
# Quy uoc: noi dung khong dung dau nhay don, de giu duoc literal '...' cua sh.
# %s la cho printf cua tp().

t_vi() {
  case "$1" in
    err_macos)      printf '%b' 'script này chỉ chạy trên macOS (dùng `security` của Keychain).' ;;
    err_no_claude)  printf '%b' 'không tìm thấy `claude` trong PATH.' ;;
    err_bad_name)   printf '%b' 'tên acc chỉ được chứa chữ, số, . _ - (nhận được: "%s")' ;;
    err_main_res)   printf '%b' '"main" là tên dành riêng cho acc đăng nhập bằng Keychain.' ;;
    err_no_token)   printf '%b' 'chưa có token cho "%s". Chạy: claude-acc add %s' ;;
    err_tmpdir)     printf '%b' 'không tạo được thư mục tạm.' ;;
    err_tmpfile)    printf '%b' 'không tạo được file tạm.' ;;
    probe_ok)       printf '%b' 'token hợp lệ, gọi được API' ;;
    trying_real)    printf '%b' 'đang thử một request thật…' ;;

    err_br_app)     printf '%b' '--browser cần tên app, vd: --browser "Brave Browser"' ;;
    err_br_bad)     printf '%b' '--browser cần tên app, không phải "%s" (thiếu tên app trước đó?)' ;;
    err_br_app2)    printf '%b' '--browser cần tên app.' ;;
    err_unknown)    printf '%b' 'tùy chọn không biết: %s (xem: claude-acc help)' ;;
    err_unknown_cmd) printf '%b' 'lệnh không biết: "%s". Xem: claude-acc help' ;;
    err_extra)      printf '%b' 'thừa tham số: %s' ;;
    usage_add)      printf '%b' 'dùng: claude-acc add <tên-acc> [--browser <app>|--url-only] [--clip|--stdin|--no-setup]' ;;
    add_overwrite)  printf '%b' '"%s" đã có token — sẽ ghi đè.' ;;
    add_no_app)     printf '%b' 'không thấy /Applications/%s.app' ;;
    add_no_app2)    printf '%b' ' — vẫn thử, nhưng kiểm tra lại tên app.' ;;
    add_default_br) printf '%b' 'Sẽ mở BROWSER MẶC ĐỊNH.' ;;
    add_default_b2) printf '%b' ' Nếu acc "%s" nằm ở browser khác, dùng\n  --browser "Brave Browser" | "Google Chrome" | "Safari"\nhoặc --url-only để tự dán URL.' ;;
    add_urlonly)    printf '%b' 'Chế độ --url-only:' ;;
    add_urlonly2)   printf '%b' ' URL duyệt sẽ tự động được COPY VÀO CLIPBOARD (không tự mở browser). Dán (Cmd+V) vào đúng cửa sổ/profile cần đăng nhập.' ;;
    add_browse_in)  printf '%b' 'Sẽ duyệt trong: %s' ;;
    add_browse_in2) printf '%b' ' — nếu nó mở nhầm profile, `claude setup-token` cũng sẽ tự in URL ở bên dưới để bạn tự dán sang cửa sổ đúng.' ;;
    add_note)       printf '%b' 'Sau khi bạn bấm Authorize (hoặc dán code nếu được hỏi), token sẽ được\ntự động bắt lại — không cần copy/paste. Nếu vì lý do nào đó không bắt được,\nbạn sẽ được hỏi dán token thủ công ngay sau đây.' ;;
    add_caught)     printf '%b' 'đã tự bắt được token' ;;
    add_caught2)    printf '%b' ' (%s…%s, %s ký tự) — không cần copy/paste.' ;;
    add_nocatch)    printf '%b' 'không bắt được token từ output của setup-token.' ;;
    add_nocatch2)   printf '%b' ' Dán tay bên dưới.' ;;
    err_clip)       printf '%b' 'clipboard không chứa chuỗi "sk-ant-…". Copy token rồi chạy lại.' ;;
    add_from_clip)  printf '%b' 'lấy từ clipboard: %s…%s (%s ký tự)' ;;
    err_empty_tok)  printf '%b' 'token rỗng, hủy.' ;;
    err_keychain)   printf '%b' 'không ghi được vào Keychain.' ;;
    add_saved)      printf '%b' 'đã lưu "%s". Đang kiểm tra bằng một request thật…' ;;
    add_ready)      printf '%b' '"%s" sẵn sàng.' ;;
    add_ready2)     printf '%b' ' Dùng: claude-acc switch %s' ;;
    add_bad)        printf '%b' 'token lưu rồi nhưng KHÔNG gọi được API.' ;;
    add_bad2)       printf '%b' '  Chạy lại `claude-acc add %s --browser "<browser của acc đó>"`.' ;;
    tok_prompt)     printf '%b' 'Token cho "%s"' ;;
    tok_prompt2)    printf '%b' ' — dán vào rồi Enter (ký tự sẽ bị ẩn), hoặc chỉ Enter để lấy từ clipboard:' ;;
    tok_got)        printf '%b' 'đã nhận: %s…%s (%s ký tự)' ;;

    usage_login)    printf '%b' 'dùng: claude-acc login [--browser <app>|--url-only]' ;;
    login_warn)     printf '%b' 'Lưu ý:' ;;
    login_warn2)    printf '%b' ' lệnh này GHI ĐÈ credential trong Keychain — acc "main" hiện tại' ;;
    login_warn3)    printf '%b' 'sẽ bị thay thế. Các acc phụ (dùng token) không bị ảnh hưởng.' ;;
    login_result)   printf '%b' 'Kết quả:' ;;

    usage_rm)       printf '%b' 'dùng: claude-acc rm <tên-acc>' ;;
    rm_notfound)    printf '%b' 'không tìm thấy token của "%s" trong Keychain (vẫn gỡ khỏi danh sách).' ;;
    rm_pinned)      printf '%b' '"%s" đang được ghim — bỏ ghim luôn.' ;;
    rm_done)        printf '%b' 'đã xóa "%s".' ;;

    ls_global)      printf '%b' 'TOÀN CỤC' ;;
    ls_here)        printf '%b' 'TẠI ĐÂY ' ;;
    ls_gui)         printf '%b' 'GUI     ' ;;
    ls_pin_of)      printf '%b' 'ghim của %s' ;;
    ls_shared_with) printf '%b' 'dùng chung ghim với %s' ;;
    ls_nopin)       printf '%b' 'không ghim riêng — theo toàn cục' ;;
    resync_done)    printf '%b' 'đã cập nhật token mới vào %s chỗ đang ghim acc này' ;;
    sync_global)    printf '%b' 'ghim toàn cục cũng đã nhận token mới' ;;
    ls_here_term)   printf '%b' 'chỉ khi bạn chạy claude từ terminal ở đây — GUI dùng dòng trên' ;;
    share_done)     printf '%b' 'đã cho %s folder khác của workspace dùng CHUNG ghim này (symlink — token chỉ nằm một chỗ)' ;;
    share_skip)     printf '%b' 'bỏ qua %s — thư mục này đã có settings.local.json riêng, không dám ghi đè' ;;
    share_merged)   printf '%b' 'ghi ghim vào %s (thư mục này giữ cấu hình riêng nên không dùng chung file được)' ;;
    git_skip)       printf '%b' 'bỏ qua %s — .claude/settings.local.json ở đó đang được git theo dõi (gỡ bằng: git rm --cached .claude/settings.local.json)' ;;
    share_merged_n) printf '%b' '(%s thư mục nhận ghim riêng vì có cấu hình riêng — vẫn đổi theo mỗi lần switch)' ;;
    share_skip_n)   printf '%b' '(%s thư mục bị bỏ qua; xem ở trên)' ;;
    ls_main_desc)   printf '%b' 'Keychain — đầy đủ connectors, Remote Control' ;;
    ls_sub)         printf '%b' 'acc phụ' ;;
    ls_sub_desc)    printf '%b' 'token — không có connectors' ;;
    ls_lost_tok)    printf '%b' 'mất token — chạy: claude-acc add %s' ;;
    ls_none)        printf '%b' 'chưa có acc phụ nào. Thêm bằng: claude-acc add <tên>' ;;
    ls_pins)        printf '%b' 'GHIM THEO THƯ MỤC' ;;
    ls_pins_hint)   printf '%b' 'claude-acc switch <tên> --here' ;;
    ls_dir_gone)    printf '%b' 'thư mục không còn — claude-acc sync' ;;
    ls_ws_summary)  printf '%b' 'cả workspace: %s folder (%s dùng chung, %s giữ cấu hình riêng)' ;;

    usage_run)      printf '%b' 'dùng: claude-acc run <tên-acc|main> [-- <tham số cho claude>]' ;;
    run_dirpin)     printf '%b' 'thư mục này đang GHIM acc "%s" (%s) — nó đè lên `run`.\n     Đổi ghim:  claude-acc switch %s --here\n     Bỏ ghim :  claude-acc switch off --here' ;;
    run_glbpin)     printf '%b' 'đang GHIM acc "%s" trong ~/.claude/settings.json — nó đè lên `run`.\n     %s' ;;
    run_fix_main)   printf '%b' 'Bỏ ghim: claude-acc switch main' ;;
    run_fix_acc)    printf '%b' 'Đổi ghim: claude-acc switch %s' ;;
    usage_env)      printf '%b' 'dùng: eval "$(claude-acc env <tên-acc|main>)"' ;;

    usage_check)    printf '%b' 'dùng: claude-acc check <tên-acc|main>' ;;
    chk_main_ok)    printf '%b' 'main dùng được' ;;
    chk_main_bad)   printf '%b' 'main KHÔNG dùng được' ;;
    chk_main_bad2)  printf '%b' ' — chạy: claude auth login' ;;
    chk_ok)         printf '%b' '%s dùng được' ;;
    chk_bad)        printf '%b' '%s KHÔNG dùng được' ;;
    chk_bad2)       printf '%b' ' — chạy lại: claude-acc add %s (chọn Y)' ;;

    un_willremove)  printf '%b' 'Sẽ gỡ bỏ:' ;;
    un_tok)         printf '%b' '  - token Keychain của "%s"' ;;
    un_cfg)         printf '%b' '  - %s (danh sách acc phụ)' ;;
    un_pin)         printf '%b' '  - bỏ ghim + xóa token trong %s' ;;
    un_glob)        printf '%b' '  - bỏ ghim trong %s (đưa về "main")' ;;
    un_bak)         printf '%b' '  - %s (bản sao lưu, còn chứa token cũ)' ;;
    un_self)        printf '%b' 'Sau bước này, xóa tay file bin: %s' ;;
    un_confirm)     printf '%b' 'Xác nhận xóa? [y/N] ' ;;
    un_cancel)      printf '%b' 'đã hủy.' ;;
    un_cantclean)   printf '%b' '  không dọn được: %s' ;;
    un_done)        printf '%b' 'xong.' ;;
    un_done2)       printf '%b' ' Xóa tiếp bin claude-acc khỏi PATH nếu muốn gỡ hoàn toàn.' ;;

    err_only_names) printf '%b' 'lệnh này chỉ nhận tên acc. Ví dụ: claude-acc %s cong-viec ca-nhan' ;;
    err_unknown_acc) printf '%b' 'không biết acc "%s". Xem danh sách: claude-acc ls' ;;
    err_no_accs)    printf '%b' 'không có acc nào để chạy.' ;;
    warm_lost)      printf '%b' 'mất token — chạy: claude-acc add %s' ;;

    usg_running)    printf '%b' 'Hỏi hạn mức của %s acc (song song)…' ;;
    usg_warn)       printf '%b' 'Lưu ý: việc hỏi là một request thật, nên nó CŨNG mở cửa sổ 5h của acc đó.' ;;
    usg_hdr_acc)    printf '%b' 'acc' ;;
    usg_hdr_5h)     printf '%b' 'cửa sổ 5h' ;;
    usg_hdr_7d)     printf '%b' 'cửa sổ 7 ngày' ;;
    usg_out)        printf '%b' 'HẾT HẠN MỨC' ;;
    usg_out_back)   printf '%b' 'về lúc %s' ;;
    usg_out_short)  printf '%b' 'HẾT' ;;
    usg_left)       printf '%b' 'còn %s' ;;
    usg_days)       printf '%b' '%s ngày' ;;
    usg_day_h)      printf '%b' '1 ngày %sh' ;;
    usg_most)       printf '%b' 'Còn nhiều nhất:' ;;
    usg_most2)      printf '%b' ' (cửa sổ nặng nhất mới dùng %s%%)' ;;
    usg_most3)      printf '%b' '  -> dùng cho repo đang làm:  claude-acc switch %s --here' ;;
    usg_nocred)     printf '%b' 'không đọc được credential của main trong Keychain' ;;
    usg_expired)    printf '%b' 'HTTP %s — token không còn dùng được' ;;
    err_ambig_ws)   printf '%b' 'thư mục này nằm trong NHIỀU workspace khác nhau (%s).\n     Mỗi workspace chạy claude ở folder [0] của nó, nên không đoán được.\n     Chỉ định thẳng: claude-acc switch <tên> --here --at <đường-dẫn-folder-0>' ;;
    err_git_track)  printf '%b' '%s của repo này ĐANG ĐƯỢC GIT THEO DÕI — ghi token vào đó là một\n     bước đi thẳng tới việc commit nhầm token lên remote.\n     Gỡ theo dõi trước rồi chạy lại:\n       git -C %s rm --cached %s' ;;
    git_excluded)   printf '%b' '  (đã thêm %s vào .git/info/exclude — chỉ máy này, không vào repo)' ;;
    err_write_repo) printf '%b' 'không sửa được %s (file lỗi cú pháp JSON?)' ;;
    err_write_glob) printf '%b' 'không sửa được %s (file lỗi cú pháp JSON?). Bản gốc: %s' ;;

    usage_switch)   printf '%b' 'dùng: claude-acc switch <tên-acc|main>' ;;
    sw_to_main)     printf '%b' 'Đã chuyển về "main"' ;;
    sw_to_main2)    printf '%b' ' (credential Keychain — đầy đủ connectors).' ;;
